<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CoverRig" Id="{4b5c6814-d6df-4a7e-907e-fb6d8f460b7d}" SpecialFunc="None">
    <Declaration><![CDATA[// FB_CoverControl with limit switches the test sets by hand. The switches are inverted (TRUE = the cover is NOT at the
// switch), see the block: SetClosed(i) puts cover i at its closed switch, SetOpen(i) at its open switch, SetMid(i) between
// them, SetBoth(i) is the limit switch fault (both switches reached). All covers start closed.
// StepStart()/StepTime() measure real time from the start of a step (the block timers run on the system time).
FUNCTION_BLOCK FB_CoverRig
VAR_INPUT
	stIn		: HalfBROT.ST_CoverIn;
	tReversalDeadTime	: TIME := T#1S;
	tMoveTimeout		: TIME := T#60S;
END_VAR
VAR
	fbComm		: FB_NullComm;
	fb			: HalfBROT.FB_CoverControl(comm := fbComm);
	stOut		: HalfBROT.ST_CoverOut;
	tonStep		: TON;
	nScans		: UDINT;
	bInit		: BOOL;
	i			: INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Scan" Id="{fa45e1cf-0199-4bdb-b285-1257bd1367cb}">
      <Declaration><![CDATA[METHOD Scan
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInit THEN
	bInit := TRUE;
	FOR i := 1 TO 3 DO
		SetClosed(i);
	END_FOR
END_IF
nScans := nScans + 1;
fb(stIn := stIn, tReversalDeadTime := tReversalDeadTime, tMoveTimeout := tMoveTimeout, stOut := stOut);
tonStep(IN := TRUE, PT := T#1H);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetClosed" Id="{f07ddbd3-6f74-4673-9748-4424d8485212}">
      <Declaration><![CDATA[METHOD SetClosed
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := TRUE;
stIn.abClosed[nCover] := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetOpen" Id="{490f400d-03d5-45e3-9722-899811e7dead}">
      <Declaration><![CDATA[METHOD SetOpen
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := FALSE;
stIn.abClosed[nCover] := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMid" Id="{00c9a2be-14d1-4ba4-916a-b49727fa7475}">
      <Declaration><![CDATA[METHOD SetMid
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := TRUE;
stIn.abClosed[nCover] := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetBoth" Id="{c55037bc-0947-40f8-bb50-0760597b1d51}">
      <Declaration><![CDATA[METHOD SetBoth
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := FALSE;
stIn.abClosed[nCover] := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AllOpen" Id="{73840876-7b9b-44ae-a0e9-8c3c372ee6d5}">
      <Declaration><![CDATA[METHOD AllOpen
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 3 DO
	SetOpen(i);
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AllMid" Id="{e4b375c9-b861-4bff-a38f-1f8331c77bf5}">
      <Declaration><![CDATA[METHOD AllMid
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 3 DO
	SetMid(i);
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OpenOutputs" Id="{101878b9-bf35-465b-8353-18f722dcbb0f}">
      <Declaration><![CDATA[METHOD OpenOutputs : STRING(3)
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// the open outputs of cover 1, 2 and 3 as "x" or "-"
OpenOutputs := '';
FOR i := 1 TO 3 DO
	IF stOut.abOpen[i] THEN
		OpenOutputs := CONCAT(OpenOutputs, 'x');
	ELSE
		OpenOutputs := CONCAT(OpenOutputs, '-');
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CloseOutputs" Id="{66e6a041-fb0d-443c-9f1a-8dc8d573f0a3}">
      <Declaration><![CDATA[METHOD CloseOutputs : STRING(3)
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// the close outputs of cover 1, 2 and 3 as "x" or "-"
CloseOutputs := '';
FOR i := 1 TO 3 DO
	IF stOut.abClose[i] THEN
		CloseOutputs := CONCAT(CloseOutputs, 'x');
	ELSE
		CloseOutputs := CONCAT(CloseOutputs, '-');
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StepStart" Id="{2ddc484f-e7ee-4fb1-8e0c-d1dc62354862}">
      <Declaration><![CDATA[METHOD StepStart
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonStep(IN := FALSE, PT := T#1H);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StepTime" Id="{c5bfb60f-9611-459a-a04e-a2094c9e2d69}">
      <Declaration><![CDATA[METHOD StepTime : BOOL
VAR_INPUT
	tTime	: TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StepTime := tonStep.ET >= tTime;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
