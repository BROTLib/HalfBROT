<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CoverRig" Id="{e2203314-89d9-492f-86dc-cf81a84886b8}" SpecialFunc="None">
    <Declaration><![CDATA[// FB_CoverControl with limit switches the test sets by hand. The switches are inverted (TRUE = the cover is NOT at the
// switch), see the block: SetClosed(i) puts cover i at its closed switch, SetOpen(i) at its open switch, SetMid(i) between
// them, SetBoth(i) is the limit switch fault (both switches reached). All covers start closed.
// StepStart()/StepTime() measure real time from the start of a step (the block timers run on the system time).
FUNCTION_BLOCK FB_CoverRig
VAR_INPUT
	stIn		: HalfBROT.ST_CoverIn := (abOpen := [TRUE, TRUE, TRUE], abClosed := [FALSE, FALSE, FALSE]);
	tReversalDeadTime	: TIME := T#1S;
	tMoveTimeout		: TIME := T#60S;
END_VAR
VAR
	fbComm		: FB_NullComm;
	fb			: HalfBROT.FB_CoverControl(comm := fbComm);
	stOut		: HalfBROT.ST_CoverOut;
	tonStep		: TON;
	nScans		: UDINT;
	i			: INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Scan" Id="{85a7aeba-bc63-4a20-ae2e-d337a1e77e5e}">
      <Declaration><![CDATA[METHOD Scan
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nScans := nScans + 1;
fb(stIn := stIn, tReversalDeadTime := tReversalDeadTime, tMoveTimeout := tMoveTimeout, stOut := stOut);
tonStep(IN := TRUE, PT := T#1H);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetClosed" Id="{1b566e8d-7ab0-40db-8b1a-92030369b521}">
      <Declaration><![CDATA[METHOD SetClosed
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := TRUE;
stIn.abClosed[nCover] := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetOpen" Id="{6afc04b9-413e-4603-85bd-ebd52cd135ec}">
      <Declaration><![CDATA[METHOD SetOpen
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := FALSE;
stIn.abClosed[nCover] := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMid" Id="{445fd19c-972b-4ca5-bb6b-521114685842}">
      <Declaration><![CDATA[METHOD SetMid
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := TRUE;
stIn.abClosed[nCover] := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetBoth" Id="{3f82eaf7-2cf1-450f-a688-e15d5b892b65}">
      <Declaration><![CDATA[METHOD SetBoth
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := FALSE;
stIn.abClosed[nCover] := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AllOpen" Id="{f280dc2a-c5f8-4efc-81ba-3de7c5bca9df}">
      <Declaration><![CDATA[METHOD AllOpen
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 3 DO
	SetOpen(i);
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AllMid" Id="{9f038d55-7175-4849-924f-57bb8244b04e}">
      <Declaration><![CDATA[METHOD AllMid
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 3 DO
	SetMid(i);
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OpenOutputs" Id="{0ada9da1-7312-4e49-a433-f5aeac5ecba4}">
      <Declaration><![CDATA[METHOD OpenOutputs : STRING(3)
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// the open outputs of cover 1, 2 and 3 as "x" or "-"
OpenOutputs := '';
FOR i := 1 TO 3 DO
	IF stOut.abOpen[i] THEN
		OpenOutputs := CONCAT(OpenOutputs, 'x');
	ELSE
		OpenOutputs := CONCAT(OpenOutputs, '-');
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CloseOutputs" Id="{a403a70f-8525-4b00-8f84-fc4a2b37c67c}">
      <Declaration><![CDATA[METHOD CloseOutputs : STRING(3)
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// the close outputs of cover 1, 2 and 3 as "x" or "-"
CloseOutputs := '';
FOR i := 1 TO 3 DO
	IF stOut.abClose[i] THEN
		CloseOutputs := CONCAT(CloseOutputs, 'x');
	ELSE
		CloseOutputs := CONCAT(CloseOutputs, '-');
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StepStart" Id="{5681bda8-8903-4ae0-9eb1-809aae94df8f}">
      <Declaration><![CDATA[METHOD StepStart
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonStep(IN := FALSE, PT := T#1H);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StepTime" Id="{111b2d37-0ce4-4e53-8035-0d6133951799}">
      <Declaration><![CDATA[METHOD StepTime : BOOL
VAR_INPUT
	tTime	: TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StepTime := tonStep.ET >= tTime;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
