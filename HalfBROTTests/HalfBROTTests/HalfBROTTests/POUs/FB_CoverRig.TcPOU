<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CoverRig" Id="{9a4ddb7e-c4bd-498c-9173-d06fb9332917}" SpecialFunc="None">
    <Declaration><![CDATA[// FB_CoverControl with limit switches the test sets by hand. The switches are inverted (TRUE = the cover is NOT at the
// switch), see the block: SetClosed(i) puts cover i at its closed switch, SetOpen(i) at its open switch, SetMid(i) between
// them, SetBoth(i) is the limit switch fault (both switches reached). All covers start closed.
// StepStart()/StepTime() measure real time from the start of a step (the block timers run on the system time).
FUNCTION_BLOCK FB_CoverRig
VAR_INPUT
	stIn		: HalfBROT.ST_CoverIn;
	tReversalDeadTime	: TIME := T#1S;
	tMoveTimeout		: TIME := T#60S;
END_VAR
VAR
	fbComm		: FB_NullComm;
	fb			: HalfBROT.FB_CoverControl(comm := fbComm);
	stOut		: HalfBROT.ST_CoverOut;
	tonStep		: TON;
	nScans		: UDINT;
	bInit		: BOOL;
	i			: INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Scan" Id="{e34593e1-f0b9-429b-87c8-ccc2e8ade63a}">
      <Declaration><![CDATA[METHOD Scan
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInit THEN
	bInit := TRUE;
	FOR i := 1 TO 3 DO
		SetClosed(i);
	END_FOR
END_IF
nScans := nScans + 1;
fb(stIn := stIn, tReversalDeadTime := tReversalDeadTime, tMoveTimeout := tMoveTimeout, stOut := stOut);
tonStep(IN := TRUE, PT := T#1H);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetClosed" Id="{9cb551c6-d738-47cb-8140-18dae3bd606f}">
      <Declaration><![CDATA[METHOD SetClosed
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := TRUE;
stIn.abClosed[nCover] := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetOpen" Id="{94acc655-8465-430a-a94a-b4f914f6a692}">
      <Declaration><![CDATA[METHOD SetOpen
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := FALSE;
stIn.abClosed[nCover] := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMid" Id="{bc030eef-5c4e-4ce7-b27f-2cb32044050d}">
      <Declaration><![CDATA[METHOD SetMid
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := TRUE;
stIn.abClosed[nCover] := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetBoth" Id="{9ff41d8c-3c46-42ab-8269-29dd990c5d43}">
      <Declaration><![CDATA[METHOD SetBoth
VAR_INPUT
	nCover	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stIn.abOpen[nCover] := FALSE;
stIn.abClosed[nCover] := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AllOpen" Id="{76d425ce-2d2e-48bb-9b5c-5296fb343b4b}">
      <Declaration><![CDATA[METHOD AllOpen
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 3 DO
	SetOpen(i);
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AllMid" Id="{aa4ef736-8ef0-4944-8705-6f08efc3d629}">
      <Declaration><![CDATA[METHOD AllMid
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO 3 DO
	SetMid(i);
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OpenOutputs" Id="{2c7bf330-1d56-4c01-996b-5cc2bd36df37}">
      <Declaration><![CDATA[METHOD OpenOutputs : STRING(3)
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// the open outputs of cover 1, 2 and 3 as "x" or "-"
OpenOutputs := '';
FOR i := 1 TO 3 DO
	IF stOut.abOpen[i] THEN
		OpenOutputs := CONCAT(OpenOutputs, 'x');
	ELSE
		OpenOutputs := CONCAT(OpenOutputs, '-');
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CloseOutputs" Id="{17fd7d57-359f-4cfa-b49e-4b4de008e6ad}">
      <Declaration><![CDATA[METHOD CloseOutputs : STRING(3)
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// the close outputs of cover 1, 2 and 3 as "x" or "-"
CloseOutputs := '';
FOR i := 1 TO 3 DO
	IF stOut.abClose[i] THEN
		CloseOutputs := CONCAT(CloseOutputs, 'x');
	ELSE
		CloseOutputs := CONCAT(CloseOutputs, '-');
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="State" Id="{8c4960f2-d163-45ee-9eb3-b133d3d277d9}">
      <Declaration><![CDATA[METHOD State : STRING(60)
]]></Declaration>
      <Implementation>
        <ST><![CDATA[State := CONCAT(CONCAT(CONCAT(CONCAT('[open ', OpenOutputs()), ' close '), CloseOutputs()), CONCAT(' err ', BOOL_TO_STRING(fb.bError)));
State := CONCAT(State, ']');
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StepStart" Id="{19bdd6ad-e678-4987-8e1f-dd785f506471}">
      <Declaration><![CDATA[METHOD StepStart
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonStep(IN := FALSE, PT := T#1H);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StepTime" Id="{5d8d0b08-48a0-4730-abec-e939eded830e}">
      <Declaration><![CDATA[METHOD StepTime : BOOL
VAR_INPUT
	tTime	: TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StepTime := tonStep.ET >= tTime;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
