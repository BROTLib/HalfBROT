<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_TestBase" Id="{43a66594-4f67-4b8f-b657-0a44c371490a}" SpecialFunc="None">
    <Declaration><![CDATA[// Base of the HalfBROTTests suites: Check() is a TcUnit assertion that also notes a failed check in GVL_Diag.sFailures
// (printed by tools/Run-Tests.ps1, TcUnit itself writes the failure text only to the ADS log). The test method sets
// sCurrent to its name first.
FUNCTION_BLOCK FB_TestBase EXTENDS TcUnit.FB_TestSuite
VAR
	sCurrent	: STRING(80);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Check" Id="{cc5bc45d-a95f-4e45-b5dc-6110dfb630ca}">
      <Declaration><![CDATA[METHOD Check
VAR_INPUT
	bCondition	: BOOL;
	sMessage	: STRING(120);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AssertTrue(Condition := bCondition, Message := sMessage);
F_Note(bFailed := NOT bCondition, sText := CONCAT(sCurrent, sMessage));
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
