  <POU Name="FB_NullComm" Id="{2ebd0003-370c-4e2b-9c85-89418b1a71e9}" SpecialFunc="None">
    <Declaration><![CDATA[// Minimal I_Comm stub for tests: every Publish/PublishLog call is a no-op that reports success,
// so FBs under test can call fbComm.Publish(...) freely without a real MQTT connection.
FUNCTION_BLOCK FB_NullComm IMPLEMENTS BROTLib.I_Comm
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Publish" Id="{0112ab4f-a440-4653-b60c-0596d6ed84b1}">
      <Declaration><![CDATA[METHOD Publish : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Publish := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
