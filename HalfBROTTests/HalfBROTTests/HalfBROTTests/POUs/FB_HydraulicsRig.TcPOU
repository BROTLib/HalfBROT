<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_HydraulicsRig" Id="{118ea6a5-f7d5-48fb-b4ee-55526416fbf5}" SpecialFunc="None">
    <Declaration><![CDATA[// FB_HydraulicsControl with a plant: the pump feedback follows the pump enable output one scan later and the oil pressure
// follows the pump (a starter and a pump that work), the suction feedback follows the suction enable. The sensors are healthy.
// bAuto calls OpenBrake() in every scan (the automatic request of MONETcommon), bManual calls ManualBrake(bSwitch) and
// feeds the switch to bBrakeClearing as MAIN of MONETS/MONETN does. tPumpResetPulse is T#0S: the pump starts at once.
// StepStart()/StepTime() measure real time from the start of a step (the block timers run on the system time).
FUNCTION_BLOCK FB_HydraulicsRig
VAR_INPUT
	stIn		: HalfBROT.ST_HydraulicsIn := (bOilLow := TRUE, bOilHigh := TRUE, bOilCold := TRUE, bOilFilterDirty := TRUE, nOilLevel := 8000);
	bClearing	: BOOL;
	bAzLimit	: BOOL;
	bAuto		: BOOL;
	bManual		: BOOL;
	bSwitch		: BOOL;
	bPumpFollows	: BOOL := TRUE;
	bPressure		: BOOL := TRUE;
	bSuctionFollows	: BOOL := TRUE;
	tHydraulicsWatchdog	: TIME := T#140S;
END_VAR
VAR
	fbComm		: FB_NullComm;
	fb			: HalfBROT.FB_HydraulicsControl(comm := fbComm);
	stOut		: HalfBROT.ST_HydraulicsOut;
	tonStep		: TON;
	nScans		: UDINT;
	nStepScans	: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Scan" Id="{a1f363e0-2067-4f1d-ac78-83086af7180f}">
      <Declaration><![CDATA[METHOD Scan
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nScans := nScans + 1;
nStepScans := nStepScans + 1;
IF bPumpFollows THEN
	stIn.bPumpRunning := stOut.bOilPumpEnable;
END_IF
stIn.bOilPressureOK := stIn.bPumpRunning AND bPressure;
IF bSuctionFollows THEN
	stIn.bSuctionRunning := stOut.bOilSuctionEnable;
END_IF
IF bAuto THEN
	fb.OpenBrake();
END_IF
IF bManual THEN
	bClearing := bSwitch;
	fb.ManualBrake(bSwitch := bSwitch);
END_IF
fb(stIn := stIn, bBrakeClearing := bClearing, bAzimuthLimitSwitch := bAzLimit, tHydraulicsWatchdog := tHydraulicsWatchdog,
	tPumpResetPulse := T#0S, stOut := stOut);
tonStep(IN := TRUE, PT := T#1H);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StepStart" Id="{dcb21be7-ec04-437e-b02a-8405643f7611}">
      <Declaration><![CDATA[METHOD StepStart
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonStep(IN := FALSE, PT := T#1H);
nStepScans := 0;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StepTime" Id="{0b1c6693-c1be-4997-93e6-ea20ce1b60da}">
      <Declaration><![CDATA[METHOD StepTime : BOOL
VAR_INPUT
	tTime	: TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StepTime := tonStep.ET >= tTime;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEnable" Id="{5d04b1f9-d77a-49d6-a2b6-64825c221285}">
      <Declaration><![CDATA[METHOD SetEnable
VAR_INPUT
	bOn	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fb.Enable := bOn;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetStopPump" Id="{e9c8584e-8698-4a35-b5ca-f6ae45e06301}">
      <Declaration><![CDATA[METHOD SetStopPump
VAR_INPUT
	bOn	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fb.ManualStopPump := bOn;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
