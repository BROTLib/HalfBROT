<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CoverControl_Tests" Id="{2a5101b3-17ca-5a94-b0b2-1153fa2f2925}" SpecialFunc="None">
    <Declaration><![CDATA[// Characterisation tests of HalfBROT.FB_CoverControl (HalfBROT#32 step 3) through the I/O structs: the sequence 1->3->2 and
// 2->3->1, the last call of Open()/Close() wins, Stop(), the latched error of a limit switch fault (#28), the move timeout and
// the reversal dead time (#27). They pin what the block does today, they are not a specification. Every test owns a rig
// (FB_CoverRig, the limit switches set by hand) and runs over several PLC cycles; the timeout and reversal tests take real time.
FUNCTION_BLOCK FB_CoverControl_Tests EXTENDS FB_TestBase
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Open_Sequence_1_3_2();
Close_Sequence_2_3_1();
Last_Call_Wins_Open_After_Close();
Last_Call_Wins_Close_After_Open();
Stop_Drops_Outputs_And_Command();
Limit_Switch_Fault_Stops_All_Until_Reset();
Move_Timeout_Is_Error();
Reversal_Waits_Dead_Time();
]]></ST>
    </Implementation>
    <Method Name="Open_Sequence_1_3_2" Id="{6b86aa9c-2d68-589f-94f5-02d5eeeffca0}">
      <Declaration><![CDATA[// Open(): cover 1 starts, cover 3 only when 1 is at its open switch, cover 2 only when 1 and 3 are; then all outputs are off.
METHOD PRIVATE Open_Sequence_1_3_2
VAR_INST
	rig		: FB_CoverRig;
	nStep	: INT;
	bViol	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Open_Sequence_1_3_2');
sCurrent := 'Open_Sequence_1_3_2: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
CASE nStep OF
0:
	Check(rig.OpenOutputs() = '---' AND rig.CloseOutputs() = '---', CONCAT('no output without a command ', rig.State()));
	rig.fb.Open();
	nStep := 10;
10:
	Check(rig.OpenOutputs() = 'x--' AND rig.CloseOutputs() = '---', CONCAT('only cover 1 starts ', rig.State()));
	Check(rig.fb.State = HalfBROT.E_CoverState.Opening, CONCAT('state Opening ', rig.State()));
	rig.SetMid(1);
	nStep := 15;
15:
	Check(rig.OpenOutputs() = 'x--', CONCAT('cover 3 waits while cover 1 is on its way ', rig.State()));
	rig.SetOpen(1);
	nStep := 20;
20:
	Check(rig.OpenOutputs() = '--x', CONCAT('cover 3 starts when cover 1 is open ', rig.State()));
	rig.SetMid(3);
	nStep := 25;
25:
	Check(rig.OpenOutputs() = '--x', CONCAT('cover 2 waits while cover 3 is on its way ', rig.State()));
	rig.SetOpen(3);
	nStep := 30;
30:
	Check(rig.OpenOutputs() = '-x-', CONCAT('cover 2 starts when 1 and 3 are open ', rig.State()));
	rig.SetOpen(2);
	nStep := 40;
40:
	Check(rig.fb.bAllOpen AND rig.fb.Opened AND NOT rig.fb.Closed, CONCAT('all covers open ', rig.State()));
	Check(rig.fb.State = HalfBROT.E_CoverState.Idle, CONCAT('state Idle after the last cover ', rig.State()));
	Check(rig.OpenOutputs() = '---' AND rig.CloseOutputs() = '---', CONCAT('all outputs off ', rig.State()));
	nStep := 50;
50:
	Check(rig.OpenOutputs() = '---', CONCAT('the command ended with the last cover ', rig.State()));
	nStep := 99;
	TEST_FINISHED();
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Close_Sequence_2_3_1" Id="{44ac1229-1e49-55b7-81df-aa7992b702da}">
      <Declaration><![CDATA[// Close(): cover 2 starts, cover 3 only when 2 is at its closed switch, cover 1 only when 2 and 3 are; then all outputs are off.
METHOD PRIVATE Close_Sequence_2_3_1
VAR_INST
	rig		: FB_CoverRig;
	nStep	: INT;
	bViol	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Close_Sequence_2_3_1');
sCurrent := 'Close_Sequence_2_3_1: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
CASE nStep OF
0:
	rig.AllOpen();
	nStep := 5;
5:
	Check(rig.OpenOutputs() = '---' AND rig.CloseOutputs() = '---', CONCAT('no output without a command ', rig.State()));
	rig.fb.Close();
	nStep := 10;
10:
	Check(rig.CloseOutputs() = '-x-' AND rig.OpenOutputs() = '---', CONCAT('only cover 2 starts ', rig.State()));
	Check(rig.fb.State = HalfBROT.E_CoverState.Closing, CONCAT('state Closing ', rig.State()));
	rig.SetMid(2);
	nStep := 15;
15:
	Check(rig.CloseOutputs() = '-x-', CONCAT('cover 3 waits while cover 2 is on its way ', rig.State()));
	rig.SetClosed(2);
	nStep := 20;
20:
	Check(rig.CloseOutputs() = '--x', CONCAT('cover 3 starts when cover 2 is closed ', rig.State()));
	rig.SetMid(3);
	nStep := 25;
25:
	Check(rig.CloseOutputs() = '--x', CONCAT('cover 1 waits while cover 3 is on its way ', rig.State()));
	rig.SetClosed(3);
	nStep := 30;
30:
	Check(rig.CloseOutputs() = 'x--', CONCAT('cover 1 starts when 2 and 3 are closed ', rig.State()));
	rig.SetClosed(1);
	nStep := 40;
40:
	Check(rig.fb.bAllClosed AND rig.fb.Closed AND NOT rig.fb.Opened, CONCAT('all covers closed ', rig.State()));
	Check(rig.OpenOutputs() = '---' AND rig.CloseOutputs() = '---', CONCAT('all outputs off ', rig.State()));
	nStep := 50;
50:
	Check(rig.CloseOutputs() = '---', CONCAT('the command ended with the last cover ', rig.State()));
	nStep := 99;
	TEST_FINISHED();
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Last_Call_Wins_Open_After_Close" Id="{d102baa1-bfde-5915-adf5-4a2f2c8fb59d}">
      <Declaration><![CDATA[// Close() then Open() in one cycle: the open request wins (Open() drops the close request).
METHOD PRIVATE Last_Call_Wins_Open_After_Close
VAR_INST
	rig		: FB_CoverRig;
	nStep	: INT;
	bViol	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Last_Call_Wins_Open_After_Close');
sCurrent := 'Last_Call_Wins_Open_After_Close: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
CASE nStep OF
0:
	rig.AllMid();
	rig.fb.Close();
	rig.fb.Open();
	nStep := 10;
10:
	Check(rig.CloseOutputs() = '---', CONCAT('no close output ', rig.State()));
	Check(rig.OpenOutputs() = 'x--', CONCAT('cover 1 opens ', rig.State()));
	nStep := 99;
	TEST_FINISHED();
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Last_Call_Wins_Close_After_Open" Id="{1f39a218-eb12-5d8d-ba00-7147d1c9fc9f}">
      <Declaration><![CDATA[// Open() then Close() in one cycle: the close request wins (Close() drops the open request).
METHOD PRIVATE Last_Call_Wins_Close_After_Open
VAR_INST
	rig		: FB_CoverRig;
	nStep	: INT;
	bViol	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Last_Call_Wins_Close_After_Open');
sCurrent := 'Last_Call_Wins_Close_After_Open: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
CASE nStep OF
0:
	rig.AllMid();
	rig.fb.Open();
	rig.fb.Close();
	nStep := 10;
10:
	Check(rig.OpenOutputs() = '---', CONCAT('no open output ', rig.State()));
	Check(rig.CloseOutputs() = '-x-', CONCAT('cover 2 closes ', rig.State()));
	nStep := 99;
	TEST_FINISHED();
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Drops_Outputs_And_Command" Id="{b8353ceb-b7a4-553a-a74e-e657460e5b0f}">
      <Declaration><![CDATA[// Stop() drops the running output in the next scan and the command with it: nothing restarts.
METHOD PRIVATE Stop_Drops_Outputs_And_Command
VAR_INST
	rig		: FB_CoverRig;
	nStep	: INT;
	bViol	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Drops_Outputs_And_Command');
sCurrent := 'Stop_Drops_Outputs_And_Command: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
CASE nStep OF
0:
	rig.fb.Open();
	nStep := 10;
10:
	Check(rig.OpenOutputs() = 'x--', CONCAT('cover 1 opens ', rig.State()));
	rig.fb.Stop();
	nStep := 20;
20:
	Check(rig.OpenOutputs() = '---' AND rig.CloseOutputs() = '---', CONCAT('the outputs are off after Stop() ', rig.State()));
	nStep := 30;
30:
	Check(rig.OpenOutputs() = '---', CONCAT('nothing restarts ', rig.State()));
	nStep := 40;
40:
	Check(rig.OpenOutputs() = '---' AND NOT rig.fb.Error, CONCAT('still off, no error ', rig.State()));
	nStep := 99;
	TEST_FINISHED();
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Limit_Switch_Fault_Stops_All_Until_Reset" Id="{7219908a-7042-5119-a16a-75181285816f}">
      <Declaration><![CDATA[// Both switches of one cover (#28): the error stops all covers and drops the command; it stays latched until Reset(), and the move needs a new Open() after it.
METHOD PRIVATE Limit_Switch_Fault_Stops_All_Until_Reset
VAR_INST
	rig		: FB_CoverRig;
	nStep	: INT;
	bViol	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Limit_Switch_Fault_Stops_All_Until_Reset');
sCurrent := 'Limit_Switch_Fault_Stops_All_Until_Reset: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
CASE nStep OF
0:
	rig.fb.Open();
	nStep := 10;
10:
	Check(rig.OpenOutputs() = 'x--', CONCAT('cover 1 opens ', rig.State()));
	rig.SetBoth(3);
	nStep := 20;
20:
	Check(rig.fb.Error AND rig.fb.bError, CONCAT('the fault is an error ', rig.State()));
	Check(rig.fb.State = HalfBROT.E_CoverState.Error, CONCAT('state Error ', rig.State()));
	Check(rig.OpenOutputs() = '---' AND rig.CloseOutputs() = '---', CONCAT('all covers stop, also those without the fault ', rig.State()));
	rig.SetClosed(3);
	rig.fb.Open();
	nStep := 30;
30:
	Check(rig.fb.Error, CONCAT('the error stays latched with the switch fixed ', rig.State()));
	Check(rig.fb.State = HalfBROT.E_CoverState.Error, CONCAT('state stays Error until Reset() ', rig.State()));
	Check(rig.OpenOutputs() = '---', CONCAT('no output while the error is latched ', rig.State()));
	rig.fb.Reset();
	nStep := 40;
40:
	Check(NOT rig.fb.Error, CONCAT('Reset() clears the error ', rig.State()));
	Check(rig.fb.State = HalfBROT.E_CoverState.Idle, CONCAT('state Idle after Reset() ', rig.State()));
	Check(rig.OpenOutputs() = '---', CONCAT('the command was dropped by the error: nothing moves ', rig.State()));
	rig.fb.Open();
	nStep := 50;
50:
	Check(rig.OpenOutputs() = 'x--', CONCAT('a new Open() moves again ', rig.State()));
	nStep := 99;
	TEST_FINISHED();
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Move_Timeout_Is_Error" Id="{1920d7b5-9cbb-5da1-a729-cfbe371b5a9a}">
      <Declaration><![CDATA[// A cover driven for tMoveTimeout (300 ms here, 60 s default) without reaching its switch stops and latches an error until Reset().
METHOD PRIVATE Move_Timeout_Is_Error
VAR_INST
	rig		: FB_CoverRig;
	nStep	: INT;
	bViol	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Move_Timeout_Is_Error');
sCurrent := 'Move_Timeout_Is_Error: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
CASE nStep OF
0:
	rig.tMoveTimeout := T#300MS;
	rig.fb.Open();
	rig.StepStart();
	nStep := 10;
10:
	IF rig.fb.Error THEN
		Check(rig.StepTime(T#250MS), CONCAT('not before the timeout ', rig.State()));
		Check(rig.OpenOutputs() = '---', CONCAT('the output is off ', rig.State()));
		Check(rig.fb.State = HalfBROT.E_CoverState.Error, CONCAT('state Error after the timeout ', rig.State()));
		rig.fb.Reset();
		nStep := 20;
	ELSIF rig.StepTime(T#2S) THEN
		Check(FALSE, 'no timeout error');
		nStep := 99;
		TEST_FINISHED();
	END_IF
20:
	Check(NOT rig.fb.Error, CONCAT('Reset() clears the timeout error ', rig.State()));
	Check(rig.OpenOutputs() = '---', CONCAT('nothing moves by itself after the reset ', rig.State()));
	nStep := 99;
	TEST_FINISHED();
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reversal_Waits_Dead_Time" Id="{f0b59d47-55f4-5cf8-bb60-9bad3671fcbf}">
      <Declaration><![CDATA[// Open() under way, then Close() (#27): the close output waits tReversalDeadTime (300 ms here, 1 s default) after the open output dropped.
METHOD PRIVATE Reversal_Waits_Dead_Time
VAR_INST
	rig		: FB_CoverRig;
	nStep	: INT;
	bViol	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Reversal_Waits_Dead_Time');
sCurrent := 'Reversal_Waits_Dead_Time: ';
IF nStep >= 90 THEN
	RETURN;
END_IF
rig.Scan();
CASE nStep OF
0:
	rig.tReversalDeadTime := T#300MS;
	rig.fb.Open();
	nStep := 10;
10:
	Check(rig.OpenOutputs() = 'x--', CONCAT('cover 1 opens ', rig.State()));
	rig.SetMid(1);
	rig.fb.Close();
	rig.StepStart();
	nStep := 20;
20:
	Check(rig.OpenOutputs() = '---', CONCAT('the open output is dropped at once ', rig.State()));
	Check(rig.CloseOutputs() = '---', CONCAT('the close output waits for the dead time ', rig.State()));
	nStep := 30;
30:
	bViol := bViol OR (rig.CloseOutputs() <> '---' AND NOT rig.StepTime(T#250MS));
	IF rig.CloseOutputs() <> '---' THEN
		Check(NOT bViol, CONCAT('no close output before the dead time ', rig.State()));
		Check(rig.StepTime(T#250MS) AND NOT rig.StepTime(T#1S), CONCAT('the close output comes after the dead time ', rig.State()));
		Check(rig.CloseOutputs() = 'x--', CONCAT('cover 1 closes ', rig.State()));
		nStep := 99;
		TEST_FINISHED();
	ELSIF rig.StepTime(T#2S) THEN
		Check(FALSE, 'the close output never came');
		nStep := 99;
		TEST_FINISHED();
	END_IF
END_CASE
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
