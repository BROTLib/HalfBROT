  <POU Name="MAIN" Id="{6ec655c2-b533-51cc-8883-4372311e0262}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// TcUnit finds every FB_TestSuite instance by itself; it is enough to declare them here.
	fbHydraulicsTests	: FB_HydraulicsControl_Tests;
	fbCoverTests		: FB_CoverControl_Tests;
	fbPendantTests		: FB_PendantControl_Tests;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TcUnit.RUN();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
