  <POU Name="MAIN" Id="{449671ac-74bd-4f1a-99f2-e4fb8333e28b}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// TcUnit finds every FB_TestSuite instance by itself; it is enough to declare them here.
