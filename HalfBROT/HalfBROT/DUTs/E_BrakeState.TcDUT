<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="E_BrakeState" Id="{97d15581-5caa-4c7b-ab06-a1b455076caa}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
// State of the brake output of FB_HydraulicsControl (HalfBROT#31 step 4).
TYPE E_BrakeState :
(
	Closed := 0,	// output off
	Opening := 1,	// output on, the brake is not reported open yet (1 s)
	Open := 2		// output on, reported open
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>