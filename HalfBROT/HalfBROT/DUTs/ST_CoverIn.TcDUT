  <DUT Name="ST_CoverIn" Id="{dd6b86c4-5c23-427b-9829-afb7b2c80e25}">
    <Declaration><![CDATA[// Process inputs of FB_CoverControl, linked in the application (GVL_IO) (#30, #31).
TYPE ST_CoverIn :
STRUCT
	abOpen	: ARRAY[1..3] OF BOOL;	// limit switch open, cover 1-3
	abClosed	: ARRAY[1..3] OF BOOL;	// limit switch closed, cover 1-3
END_STRUCT
END_TYPE
]]></Declaration>
