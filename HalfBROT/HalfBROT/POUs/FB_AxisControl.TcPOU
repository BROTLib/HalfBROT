<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_AxisControl" Id="{6fdef2a3-176a-42ec-90be-24250bb425eb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT FB_AxisControl EXTENDS FB_BaseAxis IMPLEMENTS I_Axis
VAR_INPUT
	fMinPosition			: REAL := 0;
	fMaxPosition			: REAL := 450.0;
	fCalibPosition			: LREAL := 45.0; // position of the calibration cam, used by cam homing (elevation, azimuth): set it per telescope.
											 // Ignored by the derotator (MC_ForceCalibration, absolute encoder) (#17)
	tHomeStartTimeout		: TIME := T#30S;	// a homing request that has not started after this long is dropped (#136), T#0S = wait for ever
END_VAR
VAR_OUTPUT
END_VAR
VAR
	// requests, set only through the properties MoveAxis, StopAxis, Tracking (#31); the block clears them itself
	bMoveAxis				: BOOL;		// Move azimuth to given position
	bTracking				: BOOL;		// enable tracking
	bStopAxis				: BOOL;		// stop the Axis
	fTarget					: LREAL;	// target position: fPosition clamped to the range, passed to fbAxis (the input fPosition is not overwritten) (#31)
	fSlewTime				: LREAL;	// time to reach target position

	InDigitalInputs	  AT%I*	: WORD;		// digitale inputs der Endlagen
	InDiagnostic	  AT%I*	: UDINT;	// diagnostic number
	InTorque	 	  AT%I*	: INT;		// torque feedback of the drive in 0.1 % (fTorque = InTorque / 10)
	IbSTO		  	  AT%I*	: BOOL;		// STO state of the drive: linked and shown in the Safety visualisation of MONETS/MONETN, not used by the axis logic

	axisEvent			: FB_EventLog;
	diagnosticEvent		: FB_EventLog;
	
	bDiagnosticError		: BOOL;
	
	// drive diagnostic (AX5000 S-0-0390 "Diagnostic number" in InDiagnostic), see _CheckDiagnostic (#2)
	nDiagnosticCode			: UDINT;		// InDiagnostic AND 16#FFFF: 16#Fxxx error, 16#Exxx warning, 16#Dxxx information
	bDiagnosticWarning		: BOOL;			// drive warning (16#Exxx), except the limit switch warnings ECD0/ECD1
	sDiagnosticText			: STRING(255);	// code and text for the events, e.g. 'F324: Excessive position command value deviation'
	nDiagnosticTextCode		: UDINT;		// code that sDiagnosticText was built for
	tonDiagnosticWarning	: TON;			// a warning must stand 2 s before it is logged
	diagnosticWarningEvent	: FB_EventLog;
	resetTrigger			: R_TRIG;		// rising edge of a reset request (automatic SoE reset)
	tonDiagnosticClear		: TON;			// drive free of errors for 10 s: re-arms the automatic SoE reset
	bAutoSoEResetArmed		: BOOL := TRUE;	// one automatic SoE reset per drive error
	
	fbReadParameter		: MC_ReadParameter;
	
	calibrationEvent		: FB_EventLog;
	fTorque			: REAL;	// percentage of the derotator torque
	torqueWarning			: FB_EventLog;	

	// SoE reset sequence, see _SoEReset (#14)
	nSoEResetStep			: INT;		// 0 idle, 1 started, 2 running, 10 finished
	tonSoEResetWatchdog		: TON;		// fails the sequence if FB_SoEReset never starts or never ends
	bSoEResetFailed			: BOOL;		// last SoE reset failed (cleared when the next one starts)
	sSoEResetMessage		: STRING(255);
	soeResetEvent			: FB_EventLog;

	fbJogRequest			: FB_JogRequest;	// jog requests only while the axis can jog, see _JogRequest (#148)
	fbHomeRequest			: FB_HomeRequest;	// end of the homing request bHomeAxis, see _HomeRequest (#136)
	homeTimeoutEvent		: FB_EventLog;
	homeFailedEvent			: FB_EventLog;
	fbHomeFailPosition		: FB_HomeFailPosition;	// position after a failed homing, see _HomeFailPosition (#147)
	fbSetPosition			: MC_SetPosition;
	homeRestoreEvent		: FB_EventLog;
	homeRestoreFailedEvent	: FB_EventLog;
	sRestoreMessage			: STRING(255);
	sRestoreFailedMessage	: STRING(255);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="_JogRequest" Id="{e0399c0e-93c0-47d6-a46c-a5e54450385f}">
      <Declaration><![CDATA[// Jog requests bMovePos/bMoveNeg (#148), call every cycle right before fbAxis(...) and pass fbJogRequest.bJogPos/bJogNeg as
// Jog_Forward/Jog_Backwards. A request that is stored while the axis cannot jog (disabled, error, homing, tracking, at the
// limit) is cleared and does not start the axis when the condition goes away, see FB_JogRequest.
METHOD PROTECTED _JogRequest
VAR_INPUT
	bAllowPos			: BOOL;		// the Enable_Positive passed to fbAxis
	bAllowNeg			: BOOL;		// the Enable_Negative passed to fbAxis
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbJogRequest(
	bMovePos 	:= bMovePos,
	bMoveNeg 	:= bMoveNeg,
	bCanJog 	:= fbAxis.Ready AND NOT bError AND NOT bHomeAxis AND NOT fbAxis.HomeActive AND NOT fbAxis.HomePending
	               AND NOT bTracking AND NOT fbAxis.isTracking,
	bAllowPos 	:= bAllowPos,
	bAllowNeg 	:= bAllowNeg);

IF fbJogRequest.bClearPos THEN
	bMovePos := FALSE;
END_IF
IF fbJogRequest.bClearNeg THEN
	bMoveNeg := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_HomeRequest" Id="{772c0820-5ea0-4c68-8d7a-7c6c2eb71bdd}">
      <Declaration><![CDATA[// End of the homing request bHomeAxis (#136), call every cycle right after fbAxis(...). The request is kept until the
// homing has run: a calibrated axis that is re-homed is calibrated (stale NC Homed) in the cycle of the request, before
// HomeActive. Ended through the FB_Axis handshake (HomeActive/HomePending), an axis error or tHomeStartTimeout, see FB_HomeRequest.
METHOD PROTECTED _HomeRequest
VAR_INPUT
	sAxis				: STRING;	// axis name for the event log
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbHomeRequest(
	bRequest 		:= bHomeAxis,
	bHomeActive 	:= fbAxis.HomeActive,
	bHomePending 	:= fbAxis.HomePending,
	bCalibrated 	:= fbAxis.Calibrated,
	bError 			:= bError,
	tStartTimeout 	:= tHomeStartTimeout);

IF fbHomeRequest.bRelease THEN
	// through the property: CancelHome() drops a request that has not started (timeout, error)
	THIS^.HomeAxis := FALSE;
END_IF

homeTimeoutEvent(
	Trigger 		:= fbHomeRequest.bTimedOut,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= '%s',
	OnMessage 		:= CONCAT(sAxis, ': homing did not start, request dropped.'),
	Comm 			:= fbComm);

homeFailedEvent(
	Trigger 		:= fbHomeRequest.bFailed AND NOT fbHomeRequest.bTimedOut AND NOT bError,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= '%s',
	OnMessage 		:= CONCAT(sAxis, ': homing ended without calibration.'),
	Comm 			:= fbComm);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_HomeFailPosition" Id="{6842cbf3-4f46-439e-85a4-bb18fb86d805}">
      <Declaration><![CDATA[// Position after a failed homing (#147), call every cycle right after _HomeRequest. A cam homing that fails or is stopped
// leaves the NC's virtual position (about -1e10) and the software limits refuse every jog (0x4460). The travel since the
// start of the homing is added up and MC_SetPosition sets start + travel, clamped 0.5 deg inside the window. The axis stays
// uncalibrated (jog only). Only for a homing that started on a calibrated axis, see FB_HomeFailPosition.
METHOD PROTECTED _HomeFailPosition
VAR_INPUT
	sAxis				: STRING;	// axis name for the event log
	fMin				: LREAL;	// lower end of the position window (not wider than the NC soft limits)
	fMax				: LREAL;	// upper end of the position window
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbHomeFailPosition(
	fActualPosition := fbAxis.ActualPosition,
	bHomeActive 	:= fbAxis.HomeActive,
	bHomePending 	:= fbAxis.HomePending,
	bCalibrated 	:= fbAxis.Calibrated,
	bFailed 		:= fbHomeRequest.bFailed,
	bCanSet 		:= NOT fbAxis.Error AND NOT bError AND NOT fbAxis.InMotion,
	fMin 			:= fMin,
	fMax 			:= fMax,
	bSetDone 		:= fbSetPosition.Done,
	bSetError 		:= fbSetPosition.Error);

// absolute, no motion; the axis stays uncalibrated
fbSetPosition(
	Axis 		:= axisRef,
	Execute 	:= fbHomeFailPosition.bRestore,
	Position 	:= fbHomeFailPosition.fRestorePosition,
	Mode 		:= FALSE);

IF fbHomeFailPosition.bRestored THEN
	sRestoreMessage := CONCAT(sAxis, ': homing failed, position restored to ');
	sRestoreMessage := CONCAT(sRestoreMessage, LREAL_TO_STRING(fbHomeFailPosition.fRestorePosition));
	sRestoreMessage := CONCAT(sRestoreMessage, ' (estimate ');
	sRestoreMessage := CONCAT(sRestoreMessage, LREAL_TO_STRING(fbHomeFailPosition.fEstimate));
	IF fbHomeFailPosition.bClamped THEN
		sRestoreMessage := CONCAT(sRestoreMessage, ', clamped');
	END_IF
	sRestoreMessage := CONCAT(sRestoreMessage, '); axis not calibrated, jog only.');
END_IF
homeRestoreEvent(
	Trigger 		:= fbHomeFailPosition.bRestored,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= '%s',
	OnMessage 		:= sRestoreMessage,
	Comm 			:= fbComm);

IF fbHomeFailPosition.bRestoreFailed THEN
	sRestoreFailedMessage := CONCAT(sAxis, ': position restore after the failed homing failed (error ');
	sRestoreFailedMessage := CONCAT(sRestoreFailedMessage, UDINT_TO_STRING(fbSetPosition.ErrorID));
	sRestoreFailedMessage := CONCAT(sRestoreFailedMessage, '), the position is virtual: Set Actual Position in XAE.');
END_IF
homeRestoreFailedEvent(
	Trigger 		:= fbHomeFailPosition.bRestoreFailed,
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= '%s',
	OnMessage 		:= sRestoreFailedMessage,
	Comm 			:= fbComm);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_CheckDiagnostic" Id="{97428712-b82f-4bd2-9913-b20b307cda8e}">
      <Declaration><![CDATA[// Drive diagnostic (AX5000 S-0-0390 in InDiagnostic), call every cycle after fbAxis(...) and before axisEvent (#2).
// F (error): bDiagnosticError, nErrorID := code, ERROR event; the code overrides fbAxis's ErrorID while it lasts.
// E (warning, except the limit switch warnings ECD0/ECD1): WARN event after 2 s, nErrorID untouched.
// D (information, incl. D012..D015) and 0 (drive not up yet): nothing.
// bSoEResetOnReset: a reset request (rising bReset) while the drive shows an error also resets the drive (SoE,
// via bSoEReset/_SoEReset), at most once per drive error; re-armed after 10 s without a drive error, so the
// bReset that _SoEReset sets after the drive reset cannot start another one.
METHOD PROTECTED _CheckDiagnostic
VAR_INPUT
	sAxis				: STRING;	// axis name for the event log
	bSoEResetOnReset	: BOOL;		// derotator: SoE reset on a reset while the drive shows an error
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nDiagnosticCode := InDiagnostic AND 16#FFFF;
bDiagnosticError := nDiagnosticCode >= 16#F000;
bDiagnosticWarning := nDiagnosticCode >= 16#E000 AND nDiagnosticCode < 16#F000
	AND nDiagnosticCode <> 16#ECD0 AND nDiagnosticCode <> 16#ECD1;
tonDiagnosticWarning(IN := bDiagnosticWarning, PT := T#2S);

IF bDiagnosticError THEN
	nErrorID := nDiagnosticCode;
END_IF

// event text, rebuilt only when the code changes: 'F324: Excessive position command value deviation', or only
// 'F415' when NCError_TO_STRING does not know the number (it returns the hex code then)
IF (bDiagnosticError OR bDiagnosticWarning) AND nDiagnosticCode <> nDiagnosticTextCode THEN
	sDiagnosticText := DWORD_TO_HEXSTR(nDiagnosticCode, 4, FALSE);
	IF NCError_TO_STRING(nDiagnosticCode) <> sDiagnosticText THEN
		sDiagnosticText := CONCAT(CONCAT(sDiagnosticText, ': '), NCError_TO_STRING(nDiagnosticCode));
	END_IF
	nDiagnosticTextCode := nDiagnosticCode;
END_IF

// automatic SoE reset. ResetDone covers an MC_Reset that finished in the cycle bReset rose (bReset is already
// FALSE again here then).
resetTrigger(CLK := bReset OR fbAxis.ResetDone);
tonDiagnosticClear(IN := NOT bDiagnosticError, PT := T#10S);
IF tonDiagnosticClear.Q THEN
	bAutoSoEResetArmed := TRUE;
END_IF
IF bSoEResetOnReset AND bDiagnosticError AND resetTrigger.Q AND bAutoSoEResetArmed AND nSoEResetStep = 0 THEN
	bSoEReset := TRUE;
	bAutoSoEResetArmed := FALSE;
END_IF

diagnosticEvent(
	Trigger 		:= bDiagnosticError,
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= CONCAT(sAxis, ' drive error: %s'),
	OnMessage 		:= sDiagnosticText,
	OffMessage 		:= 'cleared',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	Comm 			:= fbComm);

diagnosticWarningEvent(
	Trigger 		:= tonDiagnosticWarning.Q,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= CONCAT(sAxis, ' drive warning: %s'),
	OnMessage 		:= sDiagnosticText,
	Comm 			:= fbComm);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SoEReset" Id="{cd368f17-00a6-4e0c-8d56-6282f98096bc}">
      <Declaration><![CDATA[// Diagnostic (SoE) reset of the drive, requested with bSoEReset; call every cycle (#14).
// FB_SoEReset has no Done: the reset worked when Busy was TRUE and dropped without Error. On success the
// axis is reset (bReset) and has to home again; on failure an error is logged and the axis is not reset.
// The state is in the FB's VAR (nSoEResetStep, ...), because a method's VAR is re-created on every call.
METHOD PROTECTED _SoEReset
VAR_INPUT
	sAxis	: STRING;	// axis name for the event log
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// longer than the Timeout passed to FB_SoEReset, so it only fires if the block never starts or never ends
tonSoEResetWatchdog(IN := nSoEResetStep <> 0, PT := T#15S);

CASE nSoEResetStep OF
0:	// idle
	IF bSoEReset THEN
		bSoEResetFailed := FALSE;
		fbSoEReset(Axis := axisRef, Execute := FALSE);	// the next call is a rising edge
		nSoEResetStep := 1;
	END_IF

1, 2:	// 1: started, waiting for Busy; 2: running, waiting for Busy to drop
	fbSoEReset(
		Axis 	:= axisRef,
		Execute := TRUE,
		Timeout := DEFAULT_ADS_TIMEOUT);
	IF fbSoEReset.Error THEN
		bSoEResetFailed := TRUE;
		sSoEResetMessage := CONCAT(sAxis, ': SoE reset failed (ADS error ');
		sSoEResetMessage := CONCAT(sSoEResetMessage, UINT_TO_STRING(fbSoEReset.AdsErrId));
		sSoEResetMessage := CONCAT(sSoEResetMessage, ', SERCOS error ');
		sSoEResetMessage := CONCAT(sSoEResetMessage, UINT_TO_STRING(fbSoEReset.SercosErrId));
		sSoEResetMessage := CONCAT(sSoEResetMessage, ')');
		nSoEResetStep := 10;
	ELSIF tonSoEResetWatchdog.Q THEN
		bSoEResetFailed := TRUE;
		sSoEResetMessage := CONCAT(sAxis, ': SoE reset timed out');
		nSoEResetStep := 10;
	ELSIF fbSoEReset.Busy THEN
		nSoEResetStep := 2;
	ELSIF nSoEResetStep = 2 THEN
		nSoEResetStep := 10;	// Busy dropped without Error: done
	END_IF
END_CASE

IF nSoEResetStep = 10 THEN
	fbSoEReset(Axis := axisRef, Execute := FALSE);
	bSoEReset := FALSE;
	IF NOT bSoEResetFailed THEN
		bReset := TRUE;		// reset the axis after the drive reset, as before
	END_IF
	nSoEResetStep := 0;
END_IF

soeResetEvent(
	Trigger 		:= bSoEResetFailed,
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= '%s',
	OnMessage 		:= sSoEResetMessage,
	Comm 			:= fbComm);]]></ST>
      </Implementation>
    </Method>
    <Property Name="isTracking" Id="{d14d4ed7-aa44-40b8-a06b-dbd9bb4bc398}">
      <Declaration><![CDATA[PROPERTY isTracking : BOOL]]></Declaration>
      <Get Name="Get" Id="{d8cce5f4-c21e-4d9a-87e8-69b1f87cb648}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[isTracking := fbAxis.isTracking;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MoveAxis" Id="{62370465-c9c4-4b3d-9522-670fc80fcf7d}">
      <Declaration><![CDATA[PROPERTY MoveAxis : BOOL]]></Declaration>
      <Get Name="Get" Id="{b6a037c9-1a5a-4ccc-a67e-cd8fbf875616}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MoveAxis := bMoveAxis;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d5ee563e-2fbb-4a6b-ae57-cdb88f0e5477}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// FALSE -> TRUE starts a move to fPosition (fbAxis.MoveTo(), BROTLib #63); FALSE drops a move that has not started.
// bMoveAxis stays the level the telescopes see; the axis block clears it on MoveDone.
IF MoveAxis AND NOT bMoveAxis THEN
	fbAxis.MoveTo();
ELSIF NOT MoveAxis THEN
	fbAxis.CancelMove();
END_IF
bMoveAxis := MoveAxis;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="MoveDone" Id="{ffed8cc8-8f25-4253-859b-58a4e017102a}">
      <Declaration><![CDATA[PROPERTY MoveDone : BOOL]]></Declaration>
      <Get Name="Get" Id="{9b084521-bbd8-4f17-b07f-9acdda778b7d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MoveDone := fbAxis.MoveDone;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SlewTime" Id="{a36dc70d-226a-4ef7-9e23-e0fd5a5024cb}">
      <Declaration><![CDATA[PROPERTY SlewTime : LREAL]]></Declaration>
      <Get Name="Get" Id="{87871d10-1142-4737-afba-11d3d9c70605}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SlewTime := fSlewTime;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StopAxis" Id="{895eb35b-1f81-42b7-8416-fc32b401fd0f}">
      <Declaration><![CDATA[PROPERTY StopAxis : BOOL]]></Declaration>
      <Get Name="Get" Id="{d8fe8d4f-84fc-4959-900d-984362d0d694}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StopAxis := bStopAxis;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{7b322eb7-7271-44c8-a7b2-c7ee70ff43dc}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// FALSE -> TRUE stops the axis (fbAxis.Stop(), BROTLib #63); the axis block clears bStopAxis on StopDone.
IF StopAxis AND NOT bStopAxis THEN
	fbAxis.Stop();
END_IF
bStopAxis := StopAxis;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Tracking" Id="{4bf1bf93-5980-423d-96c9-58edc9fdb938}">
      <Declaration><![CDATA[PROPERTY Tracking : BOOL]]></Declaration>
      <Get Name="Get" Id="{e9371fc2-0020-4b0a-85b6-17721f14dcf3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Tracking := bTracking;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{4ff2f8a4-67a6-4244-b8ba-f5f82d04fc0f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[bTracking := Tracking;]]></ST>
        </Implementation>
      </Set>
    </Property>
