<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_DerotatorControl" Id="{acfc3cc1-a4bd-4873-ba58-50b0c54d8bf5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_DerotatorControl EXTENDS FB_AxisControl
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	tonTorqueError		: TON := (PT := T#3S);	// trigger for the torque error
	bOutOfRange			: BOOL;		// ActualPosition outside fMinPosition..fMaxPosition
	outOfRangeTrigger	: R_TRIG;	// stop once when leaving the range (#20)
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
Selection 6
Homing in Endlage:

https://infosys.beckhoff.com/index.php?content=../content/1031/ax5000_usermanual/html/ax5000_homing_hardware_end_position.htm&id=12221
NC-Interface:
PlcToNc-Achsinterface, Bit 8 namens AcceptBlockedDriveSignal im nDeCtrlDWord

SPS-Interface:
TcNc-Lib, siehe SPS-Funktion AxisSetAcceptBlockedDriveSignal in der TwinCAT  PLC Library: NC.
*)

fPosition := LIMIT(fMinPosition, fPosition, fMaxPosition);

IF bEnable AND NOT fbAxis.Calibrated THEN
	THIS^.HomeAxis := TRUE;
END_IF

IF fbAxis.Calibrated THEN
	bCalibrated := fbAxis.Calibrated;
	// not while the homing runs: the NC sets Homed before the homing procedure has finished
	IF NOT fbAxis.HomeActive THEN
		bHomeAxis := FALSE;
	END_IF
END_IF
	
IF bHomeAxis THEN
	fPosition := fCalibPosition;
END_IF

// Software limits: stop once when the axis leaves the range (#20). Stopping every cycle would also cancel every
// MoveTo()/Home() (fbAxis.Stop(), BROTLib #63), so the axis could not be moved back, and with the absolute
// encoder a derotator outside the range at start-up would never be homed. Further outward motion is blocked by
// Enable_Positive/Negative below, and fPosition is clamped to the range, so every move leads back in.
bOutOfRange := fbAxis.ActualPosition > fMaxPosition OR fbAxis.ActualPosition < fMinPosition;
outOfRangeTrigger(CLK := bOutOfRange);
IF outOfRangeTrigger.Q THEN
	THIS^.StopAxis := TRUE;
	// Stop() drops pending/running MoveTo() and Home(): clear the request flags so they can be requested again
	// (homing is re-requested next cycle while not calibrated)
	bMoveAxis := FALSE;
	bHomeAxis := FALSE;
END_IF

fbAxis(
	enable 			:= bEnable,
	Reset 			:= bReset,
	HomingMode 		:= MC_ForceCalibration,
	Position 		:= fPosition, 
	Velocity 		:= fVelocity,
	Enable_Positive := fbAxis.ActualPosition < fMaxPosition,
	Enable_Negative := fbAxis.ActualPosition > fMinPosition,
	Jog_Forward 	:= bMovePos,
	Jog_Backwards 	:= bMoveNeg,
	//bCalibrationCam := inDigitalInputs.0,
	isModuloAxis 	:= FALSE,
	Tracking 		:= bTracking,
	ActualPosition 	=> fActualPosition,
	Error 			=> bError,
	ErrorID 		=> nErrorID,
	AxisRef 		:= axisRef);
	
IF fbAxis.MoveDone OR bReset OR bError THEN
	bMoveAxis := FALSE;
END_IF

IF (fbAxis.HomeDone AND NOT fbAxis.HomeActive) OR bReset OR bError THEN
	bHomeAxis := FALSE;
END_IF
	
IF fbAxis.ResetDone THEN
	bReset := FALSE;
END_IF

IF fbAxis.StopDone THEN
	bStopAxis := FALSE;
END_IF

// drive diagnostic (#2); a reset while the drive shows an error also resets the drive (SoE), once per error
_CheckDiagnostic(sAxis := 'Derotator', bSoEResetOnReset := TRUE);

bReady := fbAxis.Ready;

fbReadParameter(	
	Axis 			:= axisRef, 
	Enable 			:= fbAxis.InMotion, 
	ParameterNumber := MC_AxisParameter.AxisRemainingTimeToGo, 
	ReadMode 		:= E_ReadMode.READMODE_CYCLIC);
				
IF fbReadParameter.Valid THEN
	fSlewTime := fbReadParameter.Value;
END_IF

// diagnostic reset of the drive on bSoEReset
_SoEReset(sAxis := 'Derotator');

fTorque := inTorque / 10.0;
// nominal torque is 3%, max is 25%
tonTorqueError(IN := ABS(fTorque) > 20.0);

axisEvent(	
	Trigger 		:= bError, 
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString	:= 'Derotator Axis Error: %s',
	OnMessage 		:= NCError_TO_STRING(nErrorID),
	OffMEssage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	Comm			:= fbComm);
	
TorqueWarning(	
	Trigger 		:= tonTorqueError.Q, 
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= '%s',
	OnMessage 		:= 'Derotator torque is high.',
	Comm			:= fbComm);

CalibrationEvent(	
	Trigger 		:= bCalibrated, 
	Level 			:= ADSLOG_MSGTYPE_HINT,
	OnMessage 		:= 'Derotator is calibrated.',
	Comm			:= fbComm);
	]]></ST>
    </Implementation>
    <Method Name="_StartHoming" Id="{2319eae6-c8f8-4699-9437-36645660ec26}">
      <Declaration><![CDATA[// Called by FB_BaseAxis.HomeAxis on FALSE -> TRUE: home with the reference position (BROTLib #62). MC_ForceCalibration only sets the calibrated flag, it does not move the axis or change its position: the position comes from the absolute encoder and fCalibPosition is ignored (#17).
METHOD _StartHoming : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbAxis.Home(fReference := fCalibPosition);
_StartHoming := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="InNegLimit" Id="{5e7f9e66-b876-444b-bc02-75ea47096cf0}">
      <Declaration><![CDATA[PROPERTY InNegLimit : BOOL]]></Declaration>
      <Get Name="Get" Id="{2b9866db-9dc6-47f0-beb6-6e3aa86d150c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// hardware limit input of the drive (TRUE = at the limit); used only by the pendant, the axis logic uses the
// software limits fMinPosition/fMaxPosition (#20)
InNegLimit := inDigitalInputs.1;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="InPosLimit" Id="{a6e23b26-e079-44fd-b036-d5b41f19b37a}">
      <Declaration><![CDATA[PROPERTY InPosLimit : BOOL]]></Declaration>
      <Get Name="Get" Id="{da8f7515-fc44-4a5a-a8b6-b5f4a39e4ba6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[// hardware limit input of the drive (TRUE = at the limit); used only by the pendant, the axis logic uses the
// software limits fMinPosition/fMaxPosition (#20)
InPosLimit := inDigitalInputs.0;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <LineIds Name="FB_DerotatorControl">
      <LineId Id="4057" Count="25" />
      <LineId Id="4193" Count="0" />
      <LineId Id="4192" Count="0" />
      <LineId Id="4194" Count="1" />
      <LineId Id="4083" Count="100" />
      <LineId Id="127" Count="0" />
    </LineIds>
    <LineIds Name="FB_DerotatorControl.InNegLimit.Get">
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FB_DerotatorControl.InPosLimit.Get">
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>