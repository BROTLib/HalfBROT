<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FocusManualHome" Id="{5bd5e2c0-b882-4f8e-b385-019e45c8a5c0}" SpecialFunc="None">
    <Declaration><![CDATA[// Manual re-home of the focus, calibrated or not (FB_FocusControl.bManualHome): decides a request, then follows the homing to its end.
// No NC access, the caller does the axis calls (like FB_MoveFollower). Call it once per cycle after the axis block.
// A re-home ends when no homing is active or pending any more: done if it was seen active, nothing aborted it and the
// axis is calibrated, else aborted. An aborted re-home that leaves the axis uncalibrated blocks the automatic homing
// (bBlockAutoHome), so a stop is not undone by it; the next request or any other homing request (ClearBlock) lifts that.
FUNCTION_BLOCK FB_FocusManualHome
VAR_INPUT
	bHomeActive		: BOOL;		// fbAxis.HomeActive
	bHomePending	: BOOL;		// fbAxis.HomePending
	bCalibrated		: BOOL;		// fbAxis.calibrated
	bAbortPulse		: BOOL;		// fbAxis.CommandAborted OR fbAxis.StopDone OR bError
	bError			: BOOL;		// the axis reports an error: MC_Home is over even if HomeActive stays TRUE (BROTLib keeps Execute of a failed command until Reset, #114)
END_VAR
VAR_OUTPUT
	bRunning		: BOOL;		// a request was accepted and has not ended
	bDone			: BOOL;		// one cycle: ended calibrated, was seen active, no abort seen
	bAborted		: BOOL;		// one cycle: ended otherwise
	bBlockAutoHome	: BOOL;		// ended uncalibrated: keep the automatic homing off
	fRestoreTarget	: LREAL;	// the target at the request
	bRestoreTarget	: BOOL;		// fRestoreTarget is a real target (request on a calibrated focus); else keep the position reached (#138)
END_VAR
VAR
	bActiveSeen		: BOOL;
	bAbortSeen		: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// the restore target is used up by the cycle of bDone (FB_FocusControl reads it in that cycle) (#152)
IF bDone THEN
	bRestoreTarget := FALSE;
END_IF
bDone := FALSE;
bAborted := FALSE;

IF bRunning THEN
	bActiveSeen := bActiveSeen OR bHomeActive;
	bAbortSeen := bAbortSeen OR bAbortPulse;
	bAbortSeen := bAbortSeen OR bError;
	IF (NOT bHomeActive AND NOT bHomePending) OR bError THEN
		bRunning := FALSE;
		IF bActiveSeen AND NOT bAbortSeen AND bCalibrated THEN
			bDone := TRUE;
		ELSE
			bAborted := TRUE;
			bBlockAutoHome := NOT bCalibrated;
			IF bCalibrated THEN
				bRestoreTarget := FALSE;	// the focus never left its calibration: nothing to restore later (#152)
			END_IF
		END_IF
	END_IF
END_IF
]]></ST>
    </Implementation>
    <Method Name="Request" Id="{aab99738-82f2-4818-a18c-90a456227694}">
      <Declaration><![CDATA[// Decide a request. Accepted: running, the target is kept for the end, the automatic homing is released again.
// Calibrated or not (#138): on an uncalibrated axis fPosition is no target (#115), so nothing is restored at the end,
// except the target of an earlier re-home that was aborted and left the axis uncalibrated: that one is kept (#152).
METHOD Request : E_FocusManualHome
VAR_INPUT
	bAutomatic		: BOOL;		// telescope mode is automatic
	bManualUnlock	: BOOL;
	bError			: BOOL;
	bCalibrated		: BOOL;
	bHoming			: BOOL;		// bHomeAxis OR HomeActive OR HomePending
	bMoving			: BOOL;		// fbAxis.Busy OR the follower is moving
	fTarget			: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bAutomatic THEN
	Request := E_FocusManualHome.NotAutomatic;
ELSIF bManualUnlock THEN
	Request := E_FocusManualHome.ManualUnlock;
ELSIF bError THEN
	Request := E_FocusManualHome.AxisError;
ELSIF bRunning OR bHoming THEN
	Request := E_FocusManualHome.Homing;
ELSIF bMoving THEN
	Request := E_FocusManualHome.Moving;
ELSE
	Request := E_FocusManualHome.Accepted;
	bRunning := TRUE;
	bActiveSeen := FALSE;
	bAbortSeen := FALSE;
	bBlockAutoHome := FALSE;
	IF bCalibrated THEN
		bRestoreTarget := TRUE;
		fRestoreTarget := fTarget;
	ELSIF NOT bRestoreTarget THEN
		fRestoreTarget := 0.0;
	END_IF
	// else: an earlier re-home was aborted and left the axis uncalibrated; the focus the observer had before it is
	// still the one to restore when this one ends, fTarget of an uncalibrated axis is no target (#115, #152)
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Block" Id="{7c1d4e0a-3b52-4f6e-9a18-5d2e8f0b6c43}">
      <Declaration><![CDATA[// A homing was stopped on an uncalibrated axis: keep the automatic homing off until the next request or ClearBlock.
METHOD Block
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bBlockAutoHome := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearBlock" Id="{632e5480-8205-427e-9323-5ae2ee500521}">
      <Declaration><![CDATA[// Someone else requested a homing: the automatic homing may run again.
METHOD ClearBlock
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bBlockAutoHome := FALSE;
// the automatic homing ends on the cam and restores nothing: a target kept from an aborted re-home is stale (#152)
bRestoreTarget := FALSE;
fRestoreTarget := 0.0;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>