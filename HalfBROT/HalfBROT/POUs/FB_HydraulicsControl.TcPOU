<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_HydraulicsControl" Id="{0d9c5732-af19-4096-a83e-065687a13da0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HydraulicsControl IMPLEMENTS I_Hydraulics, I_Brake
VAR_INPUT
	stIn				: ST_HydraulicsIn;	// process inputs, linked in the application (#30)
	bManualSuction		: BOOL;				// manual override to start the suction pump
	bManualPumpStop		: BOOL;				// manual override to stop the pump
	bBrakeClearing		: BOOL;				// external clearing for brakes
	bAzimuthLimitSwitch	: BOOL;				// external signal for azimuth limit switch
	nMinPanLevel		: INT := 0;			// minimum oil level from sensor
	nMaxPanLevel		: INT := 16383;		// maximum oil level from sensor
	fMinPanPercent		: REAL := 0;		// oil level percentage to be seen as empty
	fMaxPanPercent		: REAL := 90;		// oil level percentage to be seen as full
	fTelemetryInterval	: TIME := T#5S;		// publish at least this often, also without a change (#19)
	tHydraulicsWatchdog	: TIME := T#140S;	// main pump running this long without the suction pump running = bHydraulicsFailure (#10)
	tSuctionWatchdog	: TIME := T#15S;	// suction pump enabled this long without the run feedback = bSuctionFailure (a parameter so tests can shorten it)
	tPressureWatchdog	: TIME := T#30S;	// main pump enabled this long without the oil pressure = bPressureFailure (a parameter so tests can shorten it)
	nMinValidPanLevel	: INT := -32768;	// raw oil level below this is a sensor fault (wire break); the default accepts every value, no guard (MONETS#32)
	nMaxValidPanLevel	: INT := 32767;		// raw oil level above this is a sensor fault (over-range); the default accepts every value, no guard
	tPumpResetPulse		: TIME := T#1S;		// length of the reset pulse for the pump starters, also sent once before the first pump start after a PLC start and after a main pump failure; T#0S = old behaviour, reset outputs follow bReset (#120)
END_VAR
VAR_IN_OUT
	stOut			: ST_HydraulicsOut;	// process outputs, linked in the application (#30)
END_VAR
VAR_OUTPUT
	bBrakeOpen			: BOOL;				// status of the brake: is the brake open?
	bBrakeClosed		: BOOL;				// is the brake closed?
	bPressureFailure	: BOOL;				// pump is running, but the pressure remains low
	bSuctionFailure		: BOOL;				// suction was started, but it is not running
	bHydraulicsFailure	: BOOL;				// main pump is running but suction has a timeout
	bMainPumpFailure	: BOOL;
	bOilLow				: BOOL;				// oil is low
	bOilHigh			: BOOL;				// oil is high (unused?)
	bOilPressureOK		: BOOL;				// oil pressure is 25 bars
	bOilWarning			: BOOL;				// oil is on reserve
	bOilFilterDirty		: BOOL;				// oil filter is dirty
	bOilCold			: BOOL;				// oil is below 10°C
	bOilHot				: BOOL;				// oil is above 50°C
	bOilPanMaximum		: BOOL;				// swimmer
	bPumpRunning		: BOOL;				// main pump is running
	bSuctionRunning 	: BOOL := FALSE;	// suction pump is running
	bError				: BOOL;				// error condition
	bOilLevelInvalid	: BOOL;				// raw oil level outside the valid range: warning only, not published, suction on the float switch only (MONETS#32)
	bPumpResetActive	: BOOL;				// a starter reset pulse is running, the pump enable is held off (#120)
END_VAR
VAR
	// requests, set only through the methods and properties (Enable, Reset(), OpenBrake(), CloseBrake(), ManualBrake()) (#31)
	bEnable				: BOOL;				// start the hydraulics
	bReset				: BOOL;				// reset any hydraulics error
	bOpenBrake			: BOOL;				// request to open the brake, cleared when the brake closes
	bCloseBrake			: BOOL;				// request to close the brake
	rtManualBrake		: R_TRIG;			// manual brake switch went on: one request to open (#31)
	ftManualBrake		: F_TRIG;			// manual brake switch went off: the request ends
	fbComm				: I_Comm;
 
	IbOilLow : BOOL;	// 2.1
	IbOilHigh : BOOL;	// ?
	IbOilPressureOK : BOOL;	// 2.3
	IbOilHot : BOOL;	// 2.4
	IbOilCold : BOOL;	// 2.5
	IbOilFilterDirty : BOOL;	// 2.6
	IbPumpRunning : BOOL;	// 2.7
	IbSuctionRunning : BOOL;	// 2.8
	InOilLevel : INT;	//BT2
	IbOilpanMaximum : BOOL;	//DIN39 4.6
	IbOilReserve : BOOL;	//DIN40 4.7
	ObOilPumpEnable : BOOL;	//DOUT4 0.3
	ObOilSuctionEnable : BOOL; //DOUT5 0.4	
	ObBrakeAzEl : BOOL;	// brake set
	ObResetOilPump : BOOL;
	ObResetSuctionPump : BOOL;
	
	tonPressureWatchdog	: TON;				// monitors the pressure of the pump is running
	tonSuctionWatchdog	: TON;				// monitors the activation of the suction pump
	tonMainPumpWatchdog	: TON;				// monitors the activation of the main pump			
	tonHydraulicsWatchdog	: TON;				// watch the hydraulics and suction pumps
	
	ePumpState			: E_PumpState;		// state of the main pump, see the pump section of the body (#31 step 4)
	bPumpAllowed		: BOOL;				// the pump may run: requested and no reason to stop
	bPumpRequest		: BOOL;				// the pump enable wanted by the state (before the starter reset hold)
	
	eBrakeState			: E_BrakeState;		// state of the brake output, see the brake section of the body (#31 step 4)
	bBrakeRelease		: BOOL;				// a reason to close the brake this scan
	tonBrakeOpenDelay	: TON;				// wait for the brake to open after pressure has been established
	tonBrakeOpenedDelay	: TON;				// report brake opend after a short delay
	tonPressureLossDelay	: TON;				// debounce for loss of oil pressure, which closes the brake

	srErrorState			: SR;				// error state (set dominant)
	bSuctionLatched		: BOOL;				// trigger for suction pump, see F_OilSuctionLatch
	bOilLevelValid		: BOOL;				// raw oil level inside nMinValidPanLevel..nMaxValidPanLevel
	rtOilLevelInvalid	: R_TRIG;			// builds the log message once, with the raw value
	sOilLevelInvalidMessage	: STRING(255) := 'INVALID';
	tonHydraulicsOffTimer	: TON  := (PT := T#300S);	// timer to shut off hydraulics after break was closed
	fOilLevel			: REAL;
	fLastOilLevel		: REAL;				// oil level of the last publish
	rtHydraulicsFailure	: R_TRIG;			// builds the failure message once, when the watchdog trips (#10)
	sHydraulicsFailureMessage	: STRING(255) := 'FAILURE';
	fbPumpReset			: FB_PumpResetPulse;	// starter reset pulse and pump enable hold (#120)
	bResetRequested		: BOOL;				// bReset of this cycle, before the error latch clears it
	bMainPumpFault		: BOOL;				// main pump failure, kept until the next reset, for the log (bMainPumpFailure is one cycle)
	rtMainPumpFailure	: R_TRIG;
	tonComm				: TON;				// time since the last publish, periodic publish (#19)
	tonPublishHoldoff	: TON;				// at most one publish per second (#19)
	bPublishPending		: BOOL;				// a publish is requested but not sent yet
	hydraulicsLog,
	pumpLog,
	reserveLog,
	oilLowLog,
	filterLog,
	oilMaxLog,
	oilLevelInvalidLog,
	overTemperatureLog,
	underTemperatureLog,
	suctionLog,
	hydraulicsFailureLog,
	mainPumpFaultLog,
	pumpResetLog,
	brakeClearingWarning,
	brakeHydraulicsWarning,
	brakeWarning: FB_EventLog;
	
	// measures the operating cycle of the suction pump
	statusWord, lastStatus:	UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// process inputs of this scan
IbOilLow := stIn.bOilLow;
IbOilHigh := stIn.bOilHigh;
IbOilPressureOK := stIn.bOilPressureOK;
IbOilHot := stIn.bOilHot;
IbOilCold := stIn.bOilCold;
IbOilFilterDirty := stIn.bOilFilterDirty;
IbPumpRunning := stIn.bPumpRunning;
IbSuctionRunning := stIn.bSuctionRunning;
InOilLevel := stIn.nOilLevel;
IbOilpanMaximum := stIn.bOilPanMaximum;
IbOilReserve := stIn.bOilReserve;

(* 
Main control Logic for the Hydraulics system
* power on delay for main pump and suction pump
* start main pump if main control is ready (button pressed or remote)
* start suction pump if maximum in pan is reached
* suction pump runs until the oil level is below fMinPanPercent
* a raw oil level outside nMinValidPanLevel..nMaxValidPanLevel is a sensor fault (MONETS#32): the level is not
  published and does not start or stop the suction pump, only the float switch starts it; warning, no error
* stop main pump if oil is low
* stop main pump if pressure fails for 30 seconds
* the starters of both pumps get a reset pulse of tPumpResetPulse (1 s): on every reset, before the first pump start after
  a PLC start and before the first start after a main pump failure; the pump enable is held off during the pulse (#120)
*)

// get values from sensors
bOilLow 		:= NOT IbOilLow;
bOilHigh 		:= NOT IbOilHigh;
bOilWarning 	:= IbOilReserve;
bOilPressureOK 	:= IbOilPressureOK;
bOilFilterDirty := NOT IbOilFilterDirty;
bOilCold 		:= NOT IbOilCold;
bOilHot 		:= IbOilHot;
//oil_level 			:= F_YREAL(in_oil_level, 0, 16383, 0.0, 5.0);
fOilLevel		:= F_YREAL(inOilLevel, nMinPanLevel, nMaxPanLevel, 0, 100, cut := TRUE); 
bOilLevelValid	:= F_OilLevelValid(nRaw := InOilLevel, nMinValid := nMinValidPanLevel, nMaxValid := nMaxValidPanLevel);
bOilLevelInvalid := NOT bOilLevelValid;
bOilPanMaximum	:= IbOilpanMaximum;
bPumpRunning 	:= IbPumpRunning;
bSuctionRunning := IbSuctionRunning;

// the reset request is the bReset of this cycle: the pump resets are written below, after the pump request
bResetRequested := bReset;

// error state?
srErrorState(
	SET1  := bPressureFailure OR bSuctionFailure OR bHydraulicsFailure OR bOilLow OR bMainPumpFailure,
	RESET := bReset,
	Q1    => bError);
			
// clear reset, if no error present
IF NOT bError THEN
	bReset := FALSE;
END_IF

// pump state
// pump state machine. Off: not requested or stopped by hand or by the pan maximum. Starting: the enable is on, the run feedback
// is not there yet (the 10 s watchdog below fails it). Running: run feedback. Error: any error (srErrorState, latched until
// Reset()) takes every state to Error and stops the pump. The enable (ObOilPumpEnable) is written from the state here only,
// held off during a starter reset pulse (#120).
bPumpAllowed := bEnable AND NOT bError AND NOT bManualPumpStop AND NOT IbOilpanMaximum;
IF bError THEN
	ePumpState := E_PumpState.Error;
ELSIF NOT bPumpAllowed THEN
	ePumpState := E_PumpState.Off;
ELSE
	CASE ePumpState OF
		E_PumpState.Off, E_PumpState.Error:
			ePumpState := E_PumpState.Starting;
		E_PumpState.Starting:
			IF bPumpRunning THEN
				ePumpState := E_PumpState.Running;
			END_IF
		E_PumpState.Running:
			IF NOT bPumpRunning THEN
				ePumpState := E_PumpState.Starting;
			END_IF
	END_CASE
END_IF
bPumpRequest := ePumpState = E_PumpState.Starting OR ePumpState = E_PumpState.Running;

// reset the pump starters before the pump is enabled; the enable is held off during the pulse, so the 10 s pump watchdog
// starts after it (#120)
fbPumpReset(
	bResetRequest   := bResetRequested,
	bPumpRequest    := bPumpRequest,
	bPumpFailure    := bMainPumpFailure,
	bPumpRunning    := bPumpRunning,
	bSuctionRunning := bSuctionRunning,
	tPulse          := tPumpResetPulse);
ObResetOilPump     := fbPumpReset.bResetPump;
ObResetSuctionPump := fbPumpReset.bResetSuction;
bPumpResetActive   := fbPumpReset.bActive;

// switch oil pump
ObOilPumpEnable := bPumpRequest AND NOT fbPumpReset.bHoldPump;

(* This section controls the hydraulic brake responsible for azimuth and elevation.
The brake needs oil pressure to stay open. There is no brake feedback input, so the
brake state is inferred from the output, the pump and the oil pressure.
The elevation is balanced, but the brake should only be opened, if the elevation drive is activated concurrently.
*)

// losing the oil pressure with the pump running closes the brake
tonPressureLossDelay(
	IN := bPumpRunning AND NOT bOilPressureOK,
	PT := T#2S);

// close the brake if the pump is not running or the pressure is lost
IF bCloseBrake OR NOT bPumpRunning OR tonPressureLossDelay.Q THEN
	bOpenBrake := FALSE;
END_IF

// wait for pressure to build up (hack for oil_pressure_ok)
tonBrakeOpenDelay(
	IN := bPumpRunning AND bOilPressureOK,
	PT := T#3S);
		
// brake state machine. Closed: output off. The brake opens when the pressure delay has run out, the opening is requested and
// the clearing is there. Opening: output on, not yet reported. Open: reported open one second after the output. Any reason
// to close wins over the opening in the same scan and takes every state back to Closed. The output (ObBrakeAzEl) is written
// from the state here only.
bBrakeRelease := bAzimuthLimitSwitch OR bCloseBrake OR NOT bPumpRunning OR tonPressureLossDelay.Q OR NOT bBrakeClearing;
CASE eBrakeState OF
	E_BrakeState.Closed:
		IF tonBrakeOpenDelay.Q AND bOpenBrake AND bBrakeClearing AND NOT bBrakeRelease THEN
			eBrakeState := E_BrakeState.Opening;
		END_IF
	E_BrakeState.Opening, E_BrakeState.Open:
		IF bBrakeRelease THEN
			eBrakeState := E_BrakeState.Closed;
		END_IF
END_CASE
ObBrakeAzEl := eBrakeState <> E_BrakeState.Closed;

// signal that the brake is open after one second
tonBrakeOpenedDelay(
	IN := ObBrakeAzEl,
	PT := T#1000MS,
	Q  => bBrakeOpen);
IF eBrakeState = E_BrakeState.Opening AND bBrakeOpen THEN
	eBrakeState := E_BrakeState.Open;
END_IF

// brake closed?
bBrakeClosed := NOT bBrakeOpen;
IF bBrakeClosed THEN
	bCloseBrake := FALSE;
END_IF

// turn off the hydraulics if the brake is closed and the pump is still running
tonHydraulicsOffTimer(IN := bBrakeClosed AND bEnable );
IF tonHydraulicsOffTimer.Q THEN
	bEnable := FALSE;
END_IF

(* This is the end of the brake control section *)

// same as the old SR (set dominant) while the level is valid; an invalid level neither starts nor stops the suction (MONETS#32)
bSuctionLatched := F_OilSuctionLatch(
	bLatched := bSuctionLatched,
	bLevelValid := bOilLevelValid,
	fLevel := fOilLevel,
	fMinPercent := fMinPanPercent,
	fMaxPercent := fMaxPanPercent,
	bPanMaximum := bOilPanMaximum,
	bMainPumpEnabled := ObOilPumpEnable);
ObOilSuctionEnable := bSuctionLatched OR bManualSuction;					
tonSuctionWatchdog(
	IN := ObOilSuctionEnable AND NOT bSuctionRunning,
	PT := tSuctionWatchdog,
	Q  => bSuctionFailure);
					
tonPressureWatchdog(
	IN := ObOilPumpEnable AND	NOT bOilPressureOK,
	PT := tPressureWatchdog,
	Q  => bPressureFailure);
// inherited unchanged from the STELLA1 control, purpose not documented (see #10): error if the main pump
// runs for tHydraulicsWatchdog (140 s by default) without the suction pump running
tonHydraulicsWatchdog(
	IN := bPumpRunning AND NOT bSuctionRunning,
	PT := tHydraulicsWatchdog,
	Q  => bHydraulicsFailure);

tonMainPumpWatchdog(
	IN := ObOilPumpEnable AND NOT bPumpRunning,
	PT := T#10S,
	Q  => bMainPumpFailure);

statusWord.0 := bOilLow;
statusWord.1 := bOilHigh;
statusWord.2 := bOilWarning;
statusWord.3 := bOilPressureOK;
statusWord.4 := bOilFilterDirty;
statusWord.5 := bOilCold;
statusWord.6 := bOilHot;
statusWord.7 := bBrakeOpen;
statusWord.8 := bBrakeClearing;
statusWord.9 := bPumpRunning;
statusWord.10 := bSuctionRunning;
statusWord.11 := bOilPanMaximum;
statusWord.12 := ObOilPumpEnable;
statusWord.13 := ObOilSuctionEnable;
statusWord.14 := bOilLevelInvalid;

// Publish is not retried (FB_Comm_MQTT_Influx, bQueue FALSE), so publish on a change AND every
// fTelemetryInterval: a dropped message recovers within the interval. At most once per second, so contact
// bounce or level noise does not send a burst per cycle (#19). No comm assigned: nothing to publish to (#16).
tonComm(IN := TRUE, PT := fTelemetryInterval);
tonPublishHoldoff(IN := TRUE, PT := T#1S);
IF statusWord <> LastStatus OR (bOilLevelValid AND ABS(fLastOilLevel - fOilLevel) > 5) OR tonComm.Q THEN
	bPublishPending := TRUE;
END_IF

IF bPublishPending AND tonPublishHoldoff.Q AND fbComm <> 0 THEN
	bPublishPending := FALSE;
	LastStatus := statusWord;
	IF bOilLevelValid THEN
		fLastOilLevel := fOilLevel;
	END_IF
	tonComm(IN := FALSE);
	tonPublishHoldoff(IN := FALSE);
	fbComm.PublishBOOL('hydraulics', 'base', 'OilLow',		bOilLow);
	fbComm.PublishBOOL('hydraulics', 'base', 'OilHigh',		bOilHigh);
	fbComm.PublishBOOL('hydraulics', 'base', 'OilMaximum',	bOilPanMaximum);
	fbComm.PublishBOOL('hydraulics', 'base', 'OilReserve',	bOilWarning);
	fbComm.PublishBOOL('hydraulics', 'base', 'OilPressureOK', bOilPressureOK);
	fbComm.PublishBOOL('hydraulics', 'base', 'OilFilterDirty',bOilFilterDirty);
	fbComm.PublishBOOL('hydraulics', 'base', 'OilCold',		bOilCold);
	fbComm.PublishBOOL('hydraulics', 'base', 'OilHot',		bOilHot);
	fbComm.PublishBOOL('hydraulics', 'base', 'BrakeOpen',		bBrakeOpen);
	fbComm.PublishBOOL('hydraulics', 'base', 'BrakeClearing',	bBrakeClearing);
	fbComm.PublishBOOL('hydraulics', 'base', 'PumpRunning',	bPumpRunning);
	fbComm.PublishBOOL('hydraulics', 'base', 'SuctionRunning',bSuctionRunning);
	IF bOilLevelValid THEN	// an invalid level is not published as a normal value (MONETS#32)
		fbComm.PublishLREAL('hydraulics', 'base', 'OilLevel',		REAL_TO_LREAL(fOilLevel));
	END_IF
	fbComm.PublishINT('hydraulics', 'base', 'StatusWord',	statusWord);
END_IF

			  
hydraulicsLog(
	Trigger 		:= bPressureFailure OR bMainPumpFailure,
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= 'Main hydraulics pump / pressure: %s',
	OnMessage 		:= 'FAILURE',
	OffMessage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT, 
	comm 			:= fbComm);

// names the starter and the reset, the failure above only says pump or pressure; kept until the next reset (#120)
rtMainPumpFailure(CLK := bMainPumpFailure);
IF rtMainPumpFailure.Q THEN
	bMainPumpFault := TRUE;
END_IF
IF bResetRequested THEN
	bMainPumpFault := FALSE;
END_IF
mainPumpFaultLog(
	Trigger 		:= bMainPumpFault,
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= 'main pump: %s',
	OnMessage 		:= 'no run feedback 10 s after the enable, check the starter, motor protection and phase monitor in the cabinet; a reset pulse is sent to the starters on the next reset',
	OffMessage 		:= 'fault reset',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	comm 			:= fbComm);

pumpResetLog(
	Trigger 		:= fbPumpReset.bActive,
	Level 			:= ADSLOG_MSGTYPE_HINT,
	FormatString 	:= 'pump starters: reset pulse (%s)',
	OnMessage 		:= fbPumpReset.sReason,
	comm 			:= fbComm);

pumpLog(
	Trigger 		:= bPumpRunning,
	Level 			:= ADSLOG_MSGTYPE_HINT,
	FormatString 	:= 'Main hydraulics pump: %s',
	OnMessage 		:= 'START',
	OffMessage 		:= 'STOP',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT, 
	comm 			:= fbComm);
	
reserveLog(
	Trigger 		:= bOilWarning,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= 'oil reserve: %s',
	OnMessage 		:= 'LOW',
	OffMessage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT, 
	comm	 		:= fbComm);

oilLowLog(
	Trigger 		:= bOilLow,
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= 'oil level: %s',
	OnMessage 		:= 'LOW',
	OffMessage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT, 
	comm 			:= fbComm);

rtOilLevelInvalid(CLK := bOilLevelInvalid);
IF rtOilLevelInvalid.Q THEN
	sOilLevelInvalidMessage := CONCAT(CONCAT('INVALID (raw ', INT_TO_STRING(InOilLevel)), '), OilLevel not published, suction on the float switch only');
END_IF
oilLevelInvalidLog(
	Trigger 		:= bOilLevelInvalid,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= 'oil level sensor: %s',
	OnMessage 		:= sOilLevelInvalidMessage,
	OffMessage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	comm 			:= fbComm);

oilMaxLog(
	Trigger 		:= bOilPanMaximum,
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= 'oil level: %s',
	OnMessage 		:= 'MAXIMUM',
	OffMessage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT, 
	comm 			:= fbComm);	
				
filterLog(
	Trigger 		:= bOilFilterDirty,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= 'Hydraulics Filter is %s',
	OnMessage 		:= 'dirty.', 
	comm 			:= fbComm);

overTemperatureLog(
	Trigger 		:= bOilHot,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= 'Hydraulics Temperature is %s',
	OnMessage 		:= 'high.', 
	comm 			:= fbComm);
				
underTemperatureLog(
	Trigger 		:= bOilCold,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= 'Hydraulics Temperature is %s',
	OnMessage 		:= 'low.', 
	comm 			:= fbComm);

suctionLog(
	Trigger 		:= bSuctionFailure,
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= 'suction pump: %s',
	OnMessage 		:= 'FAILURE',
	OffMessage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT, 
	comm 			:= fbComm);

// the message carries the oil level and the max switch at the moment of the trip, to tell a pan that never filled
// from a suction that was never requested although it was full (#10)
rtHydraulicsFailure(CLK := bHydraulicsFailure);
IF rtHydraulicsFailure.Q THEN
	IF bOilLevelValid THEN
		sHydraulicsFailureMessage := CONCAT(CONCAT(CONCAT('FAILURE (oil level ', LREAL_TO_FMTSTR(fOilLevel, 1, TRUE)), CONCAT(' %, max switch ', BOOL_TO_STRING(bOilPanMaximum))), ')');
	ELSE
		sHydraulicsFailureMessage := CONCAT(CONCAT(CONCAT('FAILURE (oil level invalid, raw ', INT_TO_STRING(InOilLevel)), ', max switch '), CONCAT(BOOL_TO_STRING(bOilPanMaximum), ')'));
	END_IF
END_IF
hydraulicsFailureLog(
	Trigger 		:= bHydraulicsFailure,
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= 'suction pump while running main pump: %s',
	OnMessage 		:= sHydraulicsFailureMessage,
	OffMessage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT, 
	comm 			:= fbComm);
				
brakeClearingWarning(
	Trigger 		:= NOT bBrakeClearing AND bOpenBrake,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= '%s',
	OnMessage 		:= 'Cannot open brake without brake clearing.', 
	comm 			:= fbComm);

brakeWarning(	
	Trigger 		:= bBrakeOpen,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= '%s',
	OnMessage 		:= 'Brake is open.',
	OffMessage 		:= 'Brake is closed.', 
	comm 			:= fbComm);

brakeHydraulicsWarning(
	Trigger 		:= NOT bEnable AND bOpenBrake,
	Level 			:= ADSLOG_MSGTYPE_WARN,
	FormatString 	:= '%s',
	OnMessage 		:= 'Cannot open brake without running hydraulics.', 
	comm 			:= fbComm);
// process outputs of this scan
stOut.bOilPumpEnable := ObOilPumpEnable;
stOut.bOilSuctionEnable := ObOilSuctionEnable;
stOut.bBrakeAzEl := ObBrakeAzEl;
stOut.bResetOilPump := ObResetOilPump;
stOut.bResetSuctionPump := ObResetSuctionPump;]]></ST>
    </Implementation>
