      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FB_FocusControl.InPosLimit.Get">
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FB_FocusControl.SendTelemetry">
      <LineId Id="13" Count="30" />
      <LineId Id="6" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>