<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FocusControl" Id="{27922653-650e-4327-85ba-374d2f945b2c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_FocusControl EXTENDS FB_BaseAxis IMPLEMENTS I_Focus
VAR_INPUT
	fMinPosition		: LREAL := 0;	// minimum position
	fMaxPosition		: LREAL := 100;	// maximum position
	eTelescopeMode		: E_TelescopeMode;
	fHomingPosition		: LREAL := 92.02; // 104.02 - 12.00 	// reference position for homing
	fTolerance			: LREAL := 0.005;
	
	// telemetry interval
	fTelemetryInterval		: TIME := T#5S;
	ptFocusDelay			: TIME := T#500MS;
	ptBrakeDelay			: TIME := T#4S;	
END_VAR
VAR_OUTPUT
	bFocusUnlocked		: BOOL;
END_VAR
VAR
	bMoveAxis			: BOOL;		// move the axis to new position
	ObFocusUnlock AT%Q* : BOOL;		// whether focus is unlocked
	tonFocusDelay		: TON;
	tonBrakeDelay		: TON;
	bManualUnlock		: BOOL;		// manual override to unlock the focus
	tonComm 			: TON := (PT:=fTelemetryInterval);
	//getlastposition:	BOOL := TRUE;
	fbAxisEvent			: FB_EventLog;
	fbCalibrationEvent	: FB_EventLog;
	eHomingMode			: MC_HOMINGMODE := MC_DefaultHoming;
	
	IbLimitNear    AT%I*: BOOL;	// DIN29 3.4
	IbLimitFar     AT%I*: BOOL;	// DIN30 3.5
	refAxis			: AXIS_REF;
END_VAR
VAR PERSISTENT
	fLastPosition		: LREAL := -1.0;
	// DEPRECATED (#49): the old misspelled name. Persistent data is restored by name, so it is kept for one release
	// and copied to fLastPosition once (_MigrateLastPosition); remove it, and the method, in the next minor version.
	fLastPposition		: LREAL := -1.0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
Focus Control Unit
spindle gear: 5mm
brake: 86 61103H00 Var. 0005 Index C; 24VDC geglattet 0,25 A P1672/R7
motor: Faulhaber ; Schönaich ; 3557K024CR; 454  431 ; Made in germany ==> 5300 rpm
gear: Faulhaber ; MINIMOTOR SA ; swiss made ; 38/1S  43:1 ; 033896  503
Focus is locked by default
70,8W; 0,100A no load current; 2,0 Terminal resistance; 1,950A max Current 
*)

_MigrateLastPosition();

// limit to sane positions
fPosition := LIMIT(fMinPosition, fPosition, fMaxPosition);

// focus is unlocked if enabled or manually unlocked and no eror
ObFocusUnlock := (bManualUnlock OR bEnable) AND NOT bError;

// wait until the focus is unlocked for n milliseconds
tonFocusDelay(IN := ObFocusUnlock, PT := ptFocusDelay, Q => bFocusUnlocked);
// wait for brake until we are at rest
tonBrakeDelay(IN := NOT fbAxis.Busy AND fbAxis.StandStill, PT := ptBrakeDelay);

// if we are on automatic mode then position the focus
IF eTelescopeMode = E_TelescopeMode.automatic AND NOT bManualUnlock THEN
	IF fbAxis.calibrated THEN
		IF ABS(fPosition - fActualPosition) > fTolerance THEN
			IF fbAxis.Ready THEN
				// start a move on FALSE -> TRUE (BROTLib #63); bMoveAxis is cleared on MoveDone
				IF NOT bMoveAxis THEN
					fbAxis.MoveTo();
				END_IF
				bMoveAxis := TRUE;
			ELSE
				bEnable := TRUE;
			END_IF
		END_IF
		// disable the drive and lock the brake, if we stand for more than n seconds
		IF tonBrakeDelay.Q THEN
			bEnable := FALSE;
		END_IF
		// store actual position, if we are calibrated and locked
		IF NOT ObFocusUnlock THEN
			fLastPosition := fActualPosition;
		END_IF
	ELSE // not calibrated
		IF fbAxis.Ready THEN
			THIS^.HomeAxis := TRUE;
		END_IF
	END_IF
END_IF

// The encoder is incremental (reference mark). With a stored position, MC_Direct sets that position and the
// calibrated flag in one step, without motion; HomeDone only after both. Otherwise cam homing to fHomingPosition.
// (#18: MC_ForceCalibration only sets the flag, the position came from a parallel MC_SetPosition nobody checked.)
// fPosition is overwritten so the automatic positioning does not move after homing: a target set before
// calibration is lost, the caller sets it again once Calibrated.
IF bHomeAxis THEN
	IF fLastPosition > 0.0 THEN
		eHomingMode := MC_Direct;
		fPosition := fLastPosition;
	ELSE
		eHomingMode := MC_DefaultHoming;
		fPosition := fHomingPosition;
	END_IF
END_IF

// deactivate limit switches on homing
MC_SetAcceptBlockedDriveSignal(Axis := refAxis, enable := bHomeAxis);
		
fbAxis(	
	enable 			:= bFocusUnlocked,
	Reset 			:= bReset,
	homingMode 		:= eHomingMode,
	Position 		:= fPosition,
	Velocity 		:= fVelocity,
	enable_Positive := NOT IbLimitFar OR bHomeAxis,
	enable_Negative := NOT IbLimitNear,
	Jog_Forward 	:= bMovePos AND bFocusUnlocked,
	Jog_Backwards 	:= bMoveNeg AND bFocusUnlocked,
	bCalibrationCam := IbLimitFar,
	ActualPosition 	=> fActualPosition,
	Error 			=> bError,
	ErrorID 		=> nErrorID,
	axisRef 		:= refAxis);	

IF fbAxis.MoveDone THEN
	bMoveAxis := FALSE;
END_IF

IF fbAxis.HomeDone THEN
	bHomeAxis := FALSE;
	bEnable := FALSE;
	fLastPosition := fPosition;
END_IF
	
IF fbAxis.ResetDone THEN
	bReset := FALSE;
END_IF

IF fbAxis.calibrated OR bError THEN
	bHomeAxis := FALSE;
END_IF

IF bError THEN
	fLastPosition := -1.0;
END_IF

bCalibrated := fbAxis.calibrated;
bReady := fbAxis.Ready AND fbAxis.StandStill OR NOT ObFocusUnlock;

// send telemetry
// PT set in the call: the declaration's initial value is evaluated only once, at init (#19)
tonComm(IN:=TRUE, PT:=fTelemetryInterval);
IF tonComm.Q THEN // publish new payload every fTelemetryInterval
	tonComm(IN:=FALSE);
	THIS^.SendTelemetry();	
END_IF

HandleEvents();]]></ST>
    </Implementation>
    <Method Name="_StartHoming" Id="{d763a0dd-f5c6-4dbb-a6cd-b9a5c12596fe}">
      <Declaration><![CDATA[// Called by FB_BaseAxis.HomeAxis on FALSE -> TRUE: home with the reference position (BROTLib #62). MC_Direct to the stored last position if there is one, else cam homing to fHomingPosition (the same choice as eHomingMode in the body).
METHOD _StartHoming : BOOL
VAR
	fReference	: LREAL;	// Home() needs a variable (VAR_IN_OUT CONSTANT)
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_MigrateLastPosition();	// HomeAxis may be set before the body has run once
fReference := SEL(fLastPosition > 0.0, fHomingPosition, fLastPosition);
fbAxis.Home(fReference := fReference);
_StartHoming := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_MigrateLastPosition" Id="{f569a766-83bb-4e6b-b691-64e5241889be}">
      <Declaration><![CDATA[// One-time copy of the stored focus position from the misspelled persistent variable fLastPposition (#49), so the
// first homing after the update can still restore the position instead of a reference run. Remove in the next minor.
METHOD PRIVATE _MigrateLastPosition : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fLastPosition < 0.0 AND fLastPposition > 0.0 THEN
	fLastPosition := fLastPposition;
	fLastPposition := -1.0;
	_MigrateLastPosition := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="HandleEvents" Id="{375f50c9-e6ea-4fcd-9fab-a26147b70ce8}">
      <Declaration><![CDATA[METHOD PROTECTED HandleEvents : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbAxisEvent(	
	Trigger 		:= fbAxis.Error, 
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString	:= 'Focus Axis Error: %S',
	OnMessage 		:= NCError_TO_STRING(nErrorID),
	OffMEssage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	comm 			:= fbComm);

fbCalibrationEvent(
	Trigger 		:=	bCalibrated,
	Level 			:=	ADSLOG_MSGTYPE_HINT,
	OnMessage 		:= 'Focus is calibrated.',
	comm 			:= fbComm);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="InNegLimit" Id="{1d25a9c6-c26c-4c20-9f13-eca88477ee48}">
      <Declaration><![CDATA[PROPERTY PUBLIC InNegLimit : BOOL]]></Declaration>
      <Get Name="Get" Id="{88be5ca6-56e1-4d6b-8cc7-729df9681a1a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[InNegLimit := IbLimitNear;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="InPosLimit" Id="{66e2cfb2-3f2c-47bf-8a02-ad3ba18a05bd}">
      <Declaration><![CDATA[PROPERTY PUBLIC InPosLimit : BOOL]]></Declaration>
      <Get Name="Get" Id="{d6be74e5-be21-4625-abd6-363742161882}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[InPosLimit := IbLimitFar;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SendTelemetry" Id="{9492de4d-6d2e-401c-bc97-10786d283636}">
      <Declaration><![CDATA[METHOD PROTECTED SendTelemetry : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// no comm assigned in FB_Init: nothing to publish to (#16)
IF fbComm = 0 THEN
	RETURN;
END_IF
// > FOCUS
// POWER_STATE
// always '1.0': the drive is switched off at rest to engage the brake (tonBrakeDelay), which is not
// "powered off" for pyobs (#19)
//IF THIS^.Enable THEN
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.POWER_STATE', '1.0');
//ELSE
//	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.POWER_STATE', '0.0');
//END_IF
//REFERENCED
IF THIS^.Calibrated THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.REFERENCED', '1.0');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.REFERENCED', '0.0');
END_IF
//ERROR_STATE
IF THIS^.Error THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.ERROR_STATE', UDINT_TO_STRING(THIS^.ErrorID));
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.ERROR_STATE', '0');
END_IF
//MOTION_STATE
IF THIS^.Busy THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.MOTION_STATE', '1');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.MOTION_STATE', '0');
END_IF
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.CURRPOS', LREAL_TO_STRING(THIS^.ActualPosition));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.REALPOS', LREAL_TO_STRING(THIS^.ActualPosition));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.TARGETPOS', LREAL_TO_STRING(THIS^.Position));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.TARGETDISTANCE', LREAL_TO_STRING(ABS(THIS^.ActualPosition-THIS^.Position)));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.CURRSPEED', LREAL_TO_STRING(THIS^.Velocity));
]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_FocusControl">
      <LineId Id="6020" Count="115" />
      <LineId Id="136" Count="0" />
    </LineIds>
