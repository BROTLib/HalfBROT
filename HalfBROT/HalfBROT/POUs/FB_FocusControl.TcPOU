<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FocusControl" Id="{27922653-650e-4327-85ba-374d2f945b2c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_FocusControl EXTENDS FB_BaseAxis IMPLEMENTS I_Focus
VAR_INPUT
	fMinPosition		: LREAL := 0;	// minimum position
	fMaxPosition		: LREAL := 100;	// maximum position
	eTelescopeMode		: E_TelescopeMode;
	fHomingPosition		: LREAL := 92.02; // 104.02 - 12.00 	// reference position for homing
	fTolerance			: LREAL := 0.005;
	
	// telemetry interval
	fTelemetryInterval		: TIME := T#5S;
	ptFocusDelay			: TIME := T#500MS;
	ptBrakeDelay			: TIME := T#4S;	

	// ADS port of the PLC runtime whose persistent data are written (#8), 851 = first PLC runtime
	nPersistentAdsPort		: UINT := 851;

	// Set TRUE (online in XAE, by ADS or from a program) to home a calibrated focus again on its cam, e.g. when the stored
	// position is in doubt. Cleared by the block; a request that is not accepted is logged. Not for the MAIN call, which
	// would overwrite every online write.
	bManualHome				: BOOL;
END_VAR
VAR_OUTPUT
	bFocusUnlocked		: BOOL;
END_VAR
VAR
	fbFollower			: BROTLib.FB_MoveFollower;	// starts, re-targets and holds the move to fPosition (MONETcommon#122)
	fbManualHome		: FB_FocusManualHome;		// decides and follows a manual re-home (bManualHome)
	fbJogLatch			: FB_FocusJogLatch;			// a jog is running until standstill, see F_FocusTargetFollowsActual
	fbTargetInit		: FB_FocusTargetInit;		// the first calibration without a homing takes the actual position (#115)
	fHomingReference	: LREAL;	// reference of the running homing, fixed in _StartHoming (#115); 0 = not set
	eManualHome			: E_FocusManualHome;		// result of the last bManualHome request
	bHoldOnStop			: BOOL;		// Stop() was called: the target becomes the position reached at StopDone
	ObFocusUnlock AT%Q* : BOOL;		// whether focus is unlocked
	tonFocusDelay		: TON;
	fbDriveEnable		: FB_FocusDriveEnable;		// the only writer of bEnable in this block (#108, #110, #111, #114)
	bManualUnlock		: BOOL;		// manual override to unlock the focus
	tonComm 			: TON := (PT:=fTelemetryInterval);
	//getlastposition:	BOOL := TRUE;
	fbAxisEvent			: FB_EventLog;
	fbCalibrationEvent	: FB_EventLog;
	eHomingMode			: MC_HOMINGMODE := MC_DefaultHoming;
	
	IbLimitNear    AT%I*: BOOL;	// DIN29 3.4
	IbLimitFar     AT%I*: BOOL;	// DIN30 3.5
	refAxis			: AXIS_REF;

	// write of fLastPosition to disk while running, see _WritePersistentPosition (#8)
	fbWritePersistent		: FB_WritePersistentData;
	nPersistStep			: INT;		// 0 idle, 1 started, 2 running, 10 finished
	bPersistInit			: BOOL;		// fSavedPosition taken in the first cycle
	fSavedPosition			: LREAL;	// fLastPosition at the last successful write (or as restored)
	fWritePosition			: LREAL;	// fLastPosition when the running write started
	bSaveRequested			: BOOL;		// write once after HomeDone
	rtHomed					: R_TRIG;		// rising edge of 'homed and the homing procedure finished' (#80)
	tonPersistInterval		: TON;		// rate limit since the last write start
	tonPersistWatchdog		: TON;		// ends the sequence if BUSY never drops
	bPersistWriteFailed		: BOOL;		// last write failed (cleared by the next successful one)
	sPersistWriteMessage	: STRING(255);
	persistWriteEvent		: FB_EventLog;
END_VAR
VAR CONSTANT
	tPersistMinInterval		: TIME := T#60S;	// at most one write per minute
	tPersistRetryInterval	: TIME := T#10M;	// after a failed write
END_VAR
VAR PERSISTENT
	fLastPosition		: LREAL := -1.0;
	// DEPRECATED (#49): the old misspelled name. Persistent data is restored by name, so it is kept for one release
	// and copied to fLastPosition once (_MigrateLastPosition); remove it, and the method, in the next minor version.
	fLastPposition		: LREAL := -1.0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
Focus Control Unit
spindle gear: 5mm
brake: 86 61103H00 Var. 0005 Index C; 24VDC geglattet 0,25 A P1672/R7
motor: Faulhaber ; Schönaich ; 3557K024CR; 454  431 ; Made in germany ==> 5300 rpm
gear: Faulhaber ; MINIMOTOR SA ; swiss made ; 38/1S  43:1 ; 033896  503
Focus is locked by default
70,8W; 0,100A no load current; 2,0 Terminal resistance; 1,950A max Current 
*)

_MigrateLastPosition();

// the NC keeps the calibration over a PLC or TwinCAT restart while fPosition starts at 0, which the clamp below would turn
// into fMinPosition and the follower would drive there (#115): the target takes the actual position once. Before the
// clamp and the follower; fbAxis.calibrated and fActualPosition are those of the last call.
fbTargetInit(bCalibrated := fbAxis.calibrated, bHoming := bHomeAxis);
IF fbTargetInit.bSync THEN
	fPosition := fActualPosition;
END_IF

// limit to sane positions
fPosition := LIMIT(fMinPosition, fPosition, fMaxPosition);

// a jog runs until standstill (the inputs are what fbAxis reported in its last call)
fbJogLatch(bJogCommand := (bMovePos OR bMoveNeg) AND bFocusUnlocked, bStandStill := fbAxis.StandStill);

// a new target during a move restarts it, MoveDone, abort, error and stop end it (MONETcommon#122); the inputs are
// what fbAxis reported in its last call
fbFollower(
	fTarget		:= fPosition,
	fActual		:= fActualPosition,
	fTolerance	:= fTolerance,
	bActive		:= eTelescopeMode = E_TelescopeMode.automatic AND NOT bManualUnlock AND NOT fbJogLatch.bJogging
					AND fbAxis.calibrated AND NOT bHomeAxis,
	bReady		:= fbAxis.Ready,
	bMoveDone	:= fbAxis.MoveDone,
	bAborted	:= fbAxis.CommandAborted,
	bError		:= bError,
	bStopDone	:= fbAxis.StopDone);

// Stop(): hold the position reached when the stop is done
IF bHoldOnStop AND (fbAxis.StopDone OR fbAxis.StandStill) THEN
	bHoldOnStop := FALSE;
	IF fbAxis.calibrated THEN
		fPosition := fActualPosition;
	END_IF
END_IF

// after an error a reset must not resume the old move by itself
IF bError AND fbAxis.calibrated THEN
	fPosition := fActualPosition;
END_IF

// outside automatic positioning or while jogging the focus is moved by hand: the target follows it, so the follower
// does not drive back to the old target when the mode returns to automatic
IF F_FocusTargetFollowsActual(
	bAutomatic		:= eTelescopeMode = E_TelescopeMode.automatic,
	bManualUnlock	:= bManualUnlock,
	bJogging		:= fbJogLatch.bJogging,
	bCalibrated		:= fbAxis.calibrated,
	bHoming			:= bHomeAxis) THEN
	fPosition := fActualPosition;
END_IF

// if we are on automatic mode then position the focus
IF eTelescopeMode = E_TelescopeMode.automatic AND NOT bManualUnlock THEN
	IF fbAxis.calibrated THEN
		// MoveTo() starts the move, and again when the target changed during the move
		IF fbFollower.bStartMove THEN
			fbAxis.MoveTo();
		END_IF
	ELSE // not calibrated
		// not after an aborted manual re-home: a stop must not be undone by the automatic homing
		IF fbAxis.Ready AND NOT fbManualHome.bBlockAutoHome THEN
			THIS^.HomeAxis := TRUE;
		END_IF
	END_IF
END_IF

// The drive is enabled while a move or a homing is wanted and locked, after the brake delay or on a lock request, only
// when the axis is at rest: nothing else in this block writes bEnable (the pendant and the power-on write Enable).
fbDriveEnable(
	bAutomatic	:= eTelescopeMode = E_TelescopeMode.automatic AND NOT bManualUnlock,
	bCalibrated	:= fbAxis.calibrated,
	bError		:= bError,
	bMoveWanted	:= fbFollower.bNeedEnable OR fbFollower.bMoving OR fbAxis.MovePending,
	bHomeWanted	:= bHomeAxis OR fbAxis.HomeActive OR fbAxis.HomePending,
	bAtRest		:= fbAxis.StandStill AND NOT fbAxis.Busy,
	tBrakeDelay	:= ptBrakeDelay);
IF fbDriveEnable.bEnableOn THEN
	bEnable := TRUE;
ELSIF fbDriveEnable.bEnableOff THEN
	bEnable := FALSE;
END_IF

// focus is unlocked if enabled or manually unlocked and no eror
ObFocusUnlock := (bManualUnlock OR bEnable) AND NOT bError;

// wait until the focus is unlocked for n milliseconds
tonFocusDelay(IN := ObFocusUnlock, PT := ptFocusDelay, Q => bFocusUnlocked);

// store the actual position when the focus is calibrated, locked and not homing, in every mode: a focus jogged in
// manual mode must not be restored to its pre-jog position by MC_Direct after a restart (#66)
IF F_FocusTrackStoredPosition(bCalibrated := fbAxis.calibrated, bLocked := NOT ObFocusUnlock, bHoming := bHomeAxis) THEN
	fLastPosition := fActualPosition;
END_IF

// a jog before calibration moves the focus away from the stored position: home on the cam next time (#66)
IF NOT fbAxis.calibrated AND NOT bHomeAxis AND fbJogLatch.bJogging THEN
	fLastPosition := -1.0;
END_IF

// Manual re-home of a calibrated focus (bManualHome). After the automatic block: the stored position is dropped, so
// the cam homing runs and the position that is in doubt is not used again (it is not written back while bHomeAxis).
IF bHomeAxis AND NOT fbManualHome.bRunning THEN
	fbManualHome.ClearBlock();	// somebody else requested a homing
END_IF
IF bManualHome THEN
	bManualHome := FALSE;
	eManualHome := fbManualHome.Request(
		bAutomatic		:= eTelescopeMode = E_TelescopeMode.automatic,
		bManualUnlock	:= bManualUnlock,
		bError			:= bError,
		bCalibrated		:= fbAxis.calibrated,
		bHoming			:= bHomeAxis OR fbAxis.HomeActive OR fbAxis.HomePending,
		bMoving			:= fbAxis.Busy OR fbFollower.bMoving,
		fTarget			:= fPosition);
	IF eManualHome = E_FocusManualHome.Accepted THEN
		fLastPosition := -1.0;
		THIS^.HomeAxis := TRUE;		// _StartHoming: cam homing to fHomingPosition
		ADSLOGSTR(ADSLOG_MSGTYPE_HINT OR ADSLOG_MSGTYPE_LOG, 'Focus: manual re-home started at %s mm',
			LREAL_TO_STRING(fActualPosition));
	ELSE
		ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'Focus: manual re-home rejected (reason %s)',
			INT_TO_STRING(TO_INT(eManualHome)));
	END_IF
END_IF

// The encoder is incremental (reference mark). With a stored position, MC_Direct sets that position and the
// calibrated flag in one step, without motion; HomeDone only after both. Otherwise cam homing to fHomingPosition.
// (#18: MC_ForceCalibration only sets the flag, the position came from a parallel MC_SetPosition nobody checked.)
// fPosition is overwritten so the automatic positioning does not move after homing: a target set before
// calibration is lost, the caller sets it again once Calibrated.
// The mode and the reference were chosen once in _StartHoming (fHomingReference): fLastPosition is not read again, a -1
// written during an MC_Direct homing would be clamped to fMinPosition (#115). 0 = _StartHoming did not run (bHomeAxis
// written directly): the cam reference.
IF bHomeAxis THEN
	fPosition := SEL(fHomingReference > 0.0, fHomingPosition, fHomingReference);
END_IF

// deactivate limit switches on homing
MC_SetAcceptBlockedDriveSignal(Axis := refAxis, enable := bHomeAxis);
		
fbAxis(	
	enable 			:= bFocusUnlocked,
	Reset 			:= bReset,
	homingMode 		:= eHomingMode,
	Position 		:= fPosition,
	Velocity 		:= fVelocity,
	enable_Positive := NOT IbLimitFar OR bHomeAxis,
	enable_Negative := NOT IbLimitNear,
	Jog_Forward 	:= bMovePos AND bFocusUnlocked,
	Jog_Backwards 	:= bMoveNeg AND bFocusUnlocked,
	bCalibrationCam := IbLimitFar,
	ActualPosition 	=> fActualPosition,
	Error 			=> bError,
	ErrorID 		=> nErrorID,
	axisRef 		:= refAxis);	

// only when the homing has finished: the NC sets Homed (HomeDone) before the homing procedure is done
// HomeDone is a level (TRUE while the axis is homed), so only the first cycle after the homing is done is acted on (#80)
rtHomed(CLK := fbAxis.HomeDone AND NOT fbAxis.HomeActive);
IF rtHomed.Q THEN
	fbDriveEnable.RequestLock();	// lock when the axis is at rest, unless a move is wanted (#111)
	fLastPosition := fActualPosition;	// the position reached, not the target
	bSaveRequested := TRUE;	// write the new position to disk once (#8)
END_IF
	
IF fbAxis.ResetDone THEN
	bReset := FALSE;
END_IF

// HomeDone is the calibrated level (HomePending: a manual re-home starts on a calibrated axis)
IF F_FocusHomeRelease(bCalibrated := fbAxis.calibrated, bHomeActive := fbAxis.HomeActive, bHomePending := fbAxis.HomePending, bError := bError) THEN
	bHomeAxis := FALSE;
END_IF

// follow a manual re-home to its end
fbManualHome(
	bHomeActive		:= fbAxis.HomeActive,
	bHomePending	:= fbAxis.HomePending,
	bCalibrated		:= fbAxis.calibrated,
	bAbortPulse		:= fbAxis.CommandAborted OR fbAxis.StopDone OR bError);
IF fbManualHome.bDone THEN
	// back to the focus the observer had, now in the corrected calibration
	fPosition := LIMIT(fMinPosition, fbManualHome.fRestoreTarget, fMaxPosition);
	ADSLOGSTR(ADSLOG_MSGTYPE_HINT OR ADSLOG_MSGTYPE_LOG, 'Focus: manual re-home done, position %s mm',
		LREAL_TO_STRING(fActualPosition));
ELSIF fbManualHome.bAborted THEN
	THIS^.HomeAxis := FALSE;	// releases the far switch bypass of an aborted homing
	IF NOT fbAxis.calibrated THEN
		fbDriveEnable.RequestLock();
	END_IF
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'Focus: manual re-home aborted, calibrated: %s',
		BOOL_TO_STRING(fbAxis.calibrated));
END_IF

IF bError THEN
	fLastPosition := -1.0;
END_IF

bCalibrated := fbAxis.calibrated;
bReady := fbAxis.Ready AND fbAxis.StandStill OR NOT ObFocusUnlock;

// all writes to fLastPosition of this cycle are done: store it on disk when it changed (#8)
_WritePersistentPosition();

// send telemetry
// PT set in the call: the declaration's initial value is evaluated only once, at init (#19)
tonComm(IN:=TRUE, PT:=fTelemetryInterval);
IF tonComm.Q THEN // publish new payload every fTelemetryInterval
	tonComm(IN:=FALSE);
	THIS^.SendTelemetry();	
END_IF

HandleEvents();]]></ST>
    </Implementation>
    <Method Name="_StartHoming" Id="{d763a0dd-f5c6-4dbb-a6cd-b9a5c12596fe}">
      <Declaration><![CDATA[// Called by FB_BaseAxis.HomeAxis on FALSE -> TRUE: home with the reference position (BROTLib #62). MC_Direct to the stored last position if there is one, else cam homing to fHomingPosition (the choice is stored in eHomingMode, which the body uses).
METHOD _StartHoming : BOOL
VAR
	fReference	: LREAL;	// Home() needs a variable (VAR_IN_OUT CONSTANT)
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_MigrateLastPosition();	// HomeAxis may be set before the body has run once
IF F_FocusHomingReference(fLastPosition := fLastPosition, fHomingPosition := fHomingPosition, fReference => fReference) THEN
	eHomingMode := MC_Direct;
ELSE
	eHomingMode := MC_DefaultHoming;
END_IF
fHomingReference := fReference;	// the body keeps this as the target for the whole homing (#115)
fbAxis.Home(fReference := fReference);
_StartHoming := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_MigrateLastPosition" Id="{f569a766-83bb-4e6b-b691-64e5241889be}">
      <Declaration><![CDATA[// One-time copy of the stored focus position from the misspelled persistent variable fLastPposition (#49), so the
// first homing after the update can still restore the position instead of a reference run. Remove in the next minor.
METHOD PRIVATE _MigrateLastPosition : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fLastPosition < 0.0 AND fLastPposition > 0.0 THEN
	fLastPosition := fLastPposition;
	fLastPposition := -1.0;
	_MigrateLastPosition := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_WritePersistentPosition" Id="{7ff5396a-4b4e-4414-9cdc-3e90d704cf61}">
      <Declaration><![CDATA[// Persistent data are only written on a controlled TwinCAT shutdown, so after an unclean power-off fLastPosition would
// be many moves old and MC_Direct would calibrate the incremental encoder to it (#8). Write the persistent data
// (FB_WritePersistentData writes the whole persistent area of the PLC runtime) when fLastPosition changed and the
// focus is at rest, at most once per tPersistMinInterval. A failed write never affects the focus: one error event,
// retry after tPersistRetryInterval. State in the FB's VAR (a method's VAR is re-created per call).
METHOD PRIVATE _WritePersistentPosition : BOOL
VAR
	bChanged	: BOOL;
	bFailed		: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// the restored value is taken as saved, so restoring it does not trigger a write
IF NOT bPersistInit THEN
	bPersistInit := TRUE;
	fSavedPosition := fLastPosition;
END_IF

tonPersistWatchdog(IN := nPersistStep <> 0, PT := T#15S);
bFailed := FALSE;

CASE nPersistStep OF
0:	// idle
	tonPersistInterval(IN := TRUE, PT := SEL(bPersistWriteFailed, tPersistMinInterval, tPersistRetryInterval));
	// a change below the positioning tolerance does not matter; the valid/-1 change covers the error case
	bChanged := ABS(fLastPosition - fSavedPosition) > fTolerance
		OR ((fLastPosition > 0.0) <> (fSavedPosition > 0.0))
		OR bSaveRequested;
	IF bChanged AND NOT ObFocusUnlock AND NOT bHomeAxis AND NOT fbAxis.Busy AND tonPersistInterval.Q THEN
		fWritePosition := fLastPosition;
		fbWritePersistent(START := FALSE);	// the next call is a rising edge
		tonPersistInterval(IN := FALSE);
		nPersistStep := 1;
	END_IF

1, 2:	// started, running
	fbWritePersistent(
		NETID := '',
		PORT := nPersistentAdsPort,
		START := TRUE,
		TMOUT := DEFAULT_ADS_TIMEOUT,
		MODE := E_PersistentMode.SPDM_2PASS);
	IF fbWritePersistent.ERR THEN
		sPersistWriteMessage := CONCAT(CONCAT('Focus: writing persistent data failed (ADS error ', UDINT_TO_STRING(fbWritePersistent.ERRID)), ')');
		bFailed := TRUE;
	ELSIF tonPersistWatchdog.Q THEN
		sPersistWriteMessage := 'Focus: writing persistent data timed out';
		bFailed := TRUE;
	ELSIF fbWritePersistent.BUSY THEN
		nPersistStep := 2;
	ELSIF nPersistStep = 2 THEN
		nPersistStep := 10;
	END_IF

10:	// finished
	fbWritePersistent(START := FALSE);
	fSavedPosition := fWritePosition;
	bSaveRequested := FALSE;
	bPersistWriteFailed := FALSE;
	nPersistStep := 0;
END_CASE

IF bFailed THEN
	// fSavedPosition and bSaveRequested stay: the write is tried again, but only after tPersistRetryInterval
	fbWritePersistent(START := FALSE);
	bPersistWriteFailed := TRUE;
	nPersistStep := 0;
END_IF

persistWriteEvent(
	Trigger 		:= bPersistWriteFailed,
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString 	:= '%s',
	OnMessage 		:= sPersistWriteMessage,
	OffMessage 		:= 'Focus: persistent data written again',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	Comm 			:= fbComm);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{afb66802-078c-4672-893d-9d18ed5b7993}">
      <Declaration><![CDATA[// Stop a running focus move (MC_Stop) and hold the position reached: the target becomes the actual position at
// StopDone, so the automatic positioning does not restart the move. A new Position afterwards moves again.
// Returns TRUE when an MC_Stop was requested. A drive that is not enabled has nothing to stop: only the pending
// target is dropped, as a stop pending on a disabled axis would run after the next enable. MONETcommon#122.
METHOD Stop : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbFollower.Stop();
fbAxis.CancelMove();
IF fbManualHome.bRunning THEN
	fbAxis.CancelHome();	// a re-home that waits for the drive must not start after the stop
END_IF
IF fbAxis.Ready AND NOT fbAxis.StandStill THEN
	Stop := fbAxis.Stop();
	bHoldOnStop := TRUE;
ELSIF fbAxis.calibrated THEN
	fPosition := fActualPosition;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="MinPosition" Id="{1dd00a08-1707-4edd-8ffd-4ab5236e324c}">
      <Declaration><![CDATA[PROPERTY PUBLIC MinPosition : LREAL]]></Declaration>
      <Get Name="Get" Id="{d9ce3523-3c41-4511-b25d-da518d4c4f9b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MinPosition := fMinPosition;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MaxPosition" Id="{e3d2f38f-23ed-461f-ad03-31ba3e34706b}">
      <Declaration><![CDATA[PROPERTY PUBLIC MaxPosition : LREAL]]></Declaration>
      <Get Name="Get" Id="{384aaca3-379b-467d-9f43-e4c4c2f34d8c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MaxPosition := fMaxPosition;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="HandleEvents" Id="{375f50c9-e6ea-4fcd-9fab-a26147b70ce8}">
      <Declaration><![CDATA[METHOD PROTECTED HandleEvents : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbAxisEvent(	
	Trigger 		:= fbAxis.Error, 
	Level 			:= ADSLOG_MSGTYPE_ERROR,
	FormatString	:= 'Focus Axis Error: %S',
	OnMessage 		:= NCError_TO_STRING(nErrorID),
	OffMEssage 		:= 'OK',
	OffLevel 		:= ADSLOG_MSGTYPE_HINT,
	comm 			:= fbComm);

fbCalibrationEvent(
	Trigger 		:=	bCalibrated,
	Level 			:=	ADSLOG_MSGTYPE_HINT,
	OnMessage 		:= 'Focus is calibrated.',
	comm 			:= fbComm);
]]></ST>
      </Implementation>
    </Method>
    <Property Name="InNegLimit" Id="{1d25a9c6-c26c-4c20-9f13-eca88477ee48}">
      <Declaration><![CDATA[PROPERTY PUBLIC InNegLimit : BOOL]]></Declaration>
      <Get Name="Get" Id="{88be5ca6-56e1-4d6b-8cc7-729df9681a1a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[InNegLimit := IbLimitNear;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="InPosLimit" Id="{66e2cfb2-3f2c-47bf-8a02-ad3ba18a05bd}">
      <Declaration><![CDATA[PROPERTY PUBLIC InPosLimit : BOOL]]></Declaration>
      <Get Name="Get" Id="{d6be74e5-be21-4625-abd6-363742161882}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[InPosLimit := IbLimitFar;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SendTelemetry" Id="{9492de4d-6d2e-401c-bc97-10786d283636}">
      <Declaration><![CDATA[METHOD PROTECTED SendTelemetry : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// no comm assigned in FB_Init: nothing to publish to (#16)
IF fbComm = 0 THEN
	RETURN;
END_IF
// > FOCUS
// POWER_STATE
// always '1.0': the drive is switched off at rest to engage the brake (tonBrakeDelay), which is not
// "powered off" for pyobs (#19)
//IF THIS^.Enable THEN
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.POWER_STATE', '1.0');
//ELSE
//	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.POWER_STATE', '0.0');
//END_IF
//REFERENCED
IF THIS^.Calibrated THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.REFERENCED', '1.0');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.REFERENCED', '0.0');
END_IF
//ERROR_STATE
IF THIS^.Error THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.ERROR_STATE', UDINT_TO_STRING(THIS^.ErrorID));
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.ERROR_STATE', '0');
END_IF
//MOTION_STATE
IF THIS^.Busy THEN
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.MOTION_STATE', '1');
ELSE
	fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.MOTION_STATE', '0');
END_IF
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.CURRPOS', LREAL_TO_STRING(THIS^.ActualPosition));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.REALPOS', LREAL_TO_STRING(THIS^.ActualPosition));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.TARGETPOS', LREAL_TO_STRING(THIS^.Position));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.TARGETDISTANCE', LREAL_TO_STRING(ABS(THIS^.ActualPosition-THIS^.Position)));
fbComm.Publish('telescope', 'dome', 'POSITION.INSTRUMENTAL.FOCUS.CURRSPEED', LREAL_TO_STRING(THIS^.Velocity));
]]></ST>
      </Implementation>
    </Method>
