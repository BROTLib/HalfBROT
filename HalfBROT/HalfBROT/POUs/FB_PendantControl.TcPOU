<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PendantControl" Id="{e2b10f6c-d16d-4403-9ebe-8d8a369c8dbd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PendantControl
VAR_INPUT
	stIn				: ST_PendantIn;	// process inputs, linked in the application (#30)
	fbCovers			: REFERENCE TO FB_CoverControl;
	fbBrake				: REFERENCE TO FB_HydraulicsControl;
	fbHydraulics		: REFERENCE TO FB_HydraulicsControl;
	fbFocus		 		: REFERENCE TO FB_FocusControl;
	fbElevation			: REFERENCE TO FB_ElevationControl;
	fbAzimuth	 		: REFERENCE TO FB_AzimuthControl;
	fbDerotator			: REFERENCE TO FB_DerotatorControl;
	fbTelescope			: REFERENCE TO FB_AltAzTelescopeControl;	
END_VAR
VAR_IN_OUT
	stOut			: ST_PendantOut;	// process outputs, linked in the application (#30)
END_VAR
VAR
	fbComm				: I_Comm;

	// program selection of the pendant control
	Selection:	UINT;
	// pendant disconnected or selector at 0 (Selection = 0); only lights the error lamp
	Error:		BOOL;
	// not mapped to an output (no): nothing sounds (#12)
	horn:			BOOL;
	fbStartTrigger			: R_TRIG;
	DerotatorEnable:	FB_ButtonEnable;
	ElevationEnable: 	FB_ButtonEnable;
	AzimuthEnable: 		FB_ButtonEnable;
	TelescopeControlEnable: 	FB_ButtonEnable;
	TrackingEnable:			FB_ButtonEnable;
	ResetDelay:	TON;
	TwinCATRestart: TC_Restart;
	up_trigger:	R_TRIG;
	down_trigger:	R_TRIG;	
	left_trigger:	R_TRIG;
	right_trigger:	R_TRIG;
	// covers, key on: hold-to-run of the whole sequence (cover plan 2026-10-12)
	bCoverJogUp			: BOOL;
	bCoverJogDown		: BOOL;
	bCoverJogActive		: BOOL;		// the pendant started the running open/close and stops it on release
	coverUpTrigger		: R_TRIG;
	coverDownTrigger	: R_TRIG;
	// manual or automatic operation of the telescope
	telescope_mode : E_TelescopeMode;
	
	reset_trigger		: R_TRIG;
	// all references the current selection uses are valid (#16)
	bReferencesValid	: BOOL;
	ePendantState		: E_PendantState;	// what the pendant is doing, see the state section of the body (#31 step 4)

	//DIN17 2.0
	BCD0: BOOL;
	//DIN18 2.1
	BCD2: BOOL;
	//DIN19 2.2
	BCD4: BOOL;
	//DIN20 2.3
	BCD8: BOOL;
	//DIN21 2.4
	reset_switch: BOOL;
	//DIN22 2.5
	direction_up: BOOL;
	//DIN23 2.6
	direction_down: BOOL;
	//DIN24 2.7
	key_switch: BOOL;
	//DIN25 3.0 (enable)
	start_switch: BOOL;
	//DIN26 3.1
	direction_left: BOOL;
	//DIN27 3.2
	direction_right: BOOL;
	
	// Outputs
	
	//DOUT9 1.0
	lamp_up: BOOL;
	//DOUT10 1.1
	lamp_down: BOOL;
	//DOUT11 1.2
	lamp_right: BOOL;
	//DOUT12 1.3
	lamp_left: BOOL;
	//DOUT13 1.4
	lamp_error: BOOL;	
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[// process inputs of this scan
BCD0 := stIn.bBCD0;
BCD2 := stIn.bBCD2;
BCD4 := stIn.bBCD4;
BCD8 := stIn.bBCD8;
reset_switch := stIn.bResetSwitch;
direction_up := stIn.bDirectionUp;
direction_down := stIn.bDirectionDown;
key_switch := stIn.bKeySwitch;
start_switch := stIn.bStartSwitch;
direction_left := stIn.bDirectionLeft;
direction_right := stIn.bDirectionRight;

(* 
This program is responsible for the manual control of the telescope.
all movable parts can be controlled from here. This is mainly for testing and
maintenance.
WARNING! Some of the safety routines are disabled, when operating the telescope manually.
*)
// calculate the value of the selector
Selection := 1*BOOL_TO_UINT(BCD0) + 
			 2*BOOL_TO_UINT(BCD2) + 
			 4*BOOL_TO_UINT(BCD4) +
			 8*BOOL_TO_UINT(BCD8);

// selector reads 0: pendant disconnected (or selector at 0). Only lights the error lamp, no stop (#12)
Error := (Selection = 0);

// disable all the lamps
lamp_left := FALSE;
lamp_right := FALSE;
lamp_up := FALSE;
lamp_down := FALSE;
horn := FALSE;

up_trigger(CLK := direction_up);
down_trigger(CLK := direction_down);
left_trigger(CLK := direction_left);
right_trigger(CLK := direction_right);
// error lamp: Error by default; the selected function overwrites it below with its own error
lamp_error := Error;


// determine the operation of the telescope based on the switch set
IF key_switch THEN
	telescope_mode := E_TelescopeMode.manual;
ELSE
	telescope_mode := E_TelescopeMode.automatic;
END_IF

// reset or start pushed?
reset_trigger(CLK := reset_switch);
fbStartTrigger(CLK := start_switch);

// covers, key on, selection 1-3: hold-to-run of the whole sequence (open 1->3->2, close 2->3->1); the cover block does
// the order, interlock, timeout and dead time. A run the pendant started stops when the button is released, the key
// goes off or the selector leaves 1-3 (#5, cover part). After an error a new press is needed (edge, not level).
bCoverJogUp := key_switch AND Selection >= 1 AND Selection <= 3 AND direction_up AND NOT direction_down;
bCoverJogDown := key_switch AND Selection >= 1 AND Selection <= 3 AND direction_down AND NOT direction_up;
coverUpTrigger(CLK := bCoverJogUp);
coverDownTrigger(CLK := bCoverJogDown);
IF __ISVALIDREF(fbCovers) THEN
	IF coverDownTrigger.Q THEN
		fbCovers.Close();
		bCoverJogActive := TRUE;
	ELSIF coverUpTrigger.Q THEN
		fbCovers.Open();
		bCoverJogActive := TRUE;
	ELSIF bCoverJogActive AND NOT bCoverJogUp AND NOT bCoverJogDown THEN
		fbCovers.Stop();
		bCoverJogActive := FALSE;
	END_IF
END_IF

// enable only the selected item and connect lamps and buttons accordingly
// a selection whose blocks are not connected does nothing and lights the error lamp:
// using an unset reference stops the PLC task (#16)
bReferencesValid := _ReferencesValid(nSelection := Selection);
// state: the selector at 0 is a pendant that is not connected; a selection whose blocks are not connected does nothing and
// lights the error lamp; otherwise the key switch decides between manual and automatic. The functions run in Automatic and
// Manual, each one checks the key itself.
IF Selection = 0 THEN
	ePendantState := E_PendantState.Disconnected;
ELSIF NOT bReferencesValid THEN
	ePendantState := E_PendantState.ReferencesMissing;
ELSIF key_switch THEN
	ePendantState := E_PendantState.Manual;
ELSE
	ePendantState := E_PendantState.Automatic;
END_IF
IF ePendantState = E_PendantState.ReferencesMissing THEN
	lamp_error := TRUE;
ELSIF ePendantState <> E_PendantState.Disconnected THEN
	CASE Selection OF
		1, 2, 3:	// covers: the whole sequence (hold-to-run above); single covers are not moved separately
			lamp_up := fbCovers.IabCoverOpen[Selection];		// lit while the selected cover is not open
			lamp_down := fbCovers.IabCoverClosed[Selection];	// lit while the selected cover is not closed
			IF key_switch THEN
				lamp_error := fbCovers.abCoverError[Selection];
			ELSE
				IF direction_down THEN 
					fbCovers.Close();
				ELSIF direction_up THEN
					fbCovers.Open();
				END_IF		
			END_IF
			
		4:	// Nasmyth / mirror M3 control
			
		5:	// Focus Control
			lamp_up := fbFocus.Ready AND NOT fbFocus.InPosLimit;
			lamp_down := fbFocus.Ready AND NOT fbFocus.InNegLimit;
			IF key_switch THEN
				IF fbStartTrigger.Q THEN
					fbFocus.Enable := NOT fbFocus.Enable;
				END_IF
				fbFocus.MovePos := direction_up;
				fbFocus.MoveNeg := direction_down;
				IF reset_trigger.Q THEN
					fbFocus.Reset();
				END_IF
				lamp_error := fbFocus.Error;
			END_IF
								
		6:	// Derotator control: no hardware limit switches, the soft limits in the NC axis (XAE) and fMin/MaxPosition stop it
			lamp_left  := fbDerotator.Ready;
			lamp_right := fbDerotator.Ready;
			IF key_switch THEN
				DerotatorEnable(SET := start_switch, Q := fbDerotator.bEnable);
				fbDerotator.MoveNeg := direction_left;
				fbDerotator.MovePos := direction_right;
				fbDerotator.bReset := reset_switch;
				lamp_error := fbDerotator.Error;
			END_IF
								
		7:	// Elevation Control
			
			fbElevation.MovePos := direction_up AND fbElevation.inDigitalInputs.0;
			fbElevation.MoveNeg := direction_down AND fbElevation.inDigitalInputs.1;
			IF key_switch THEN
				ElevationEnable(
					SET := start_switch, 
					Q := fbElevation.bEnable);	
			END_IF
			fbElevation.bReset := reset_switch;
			lamp_up := fbElevation.inDigitalInputs.0;
			lamp_down := fbElevation.inDigitalInputs.1;
			lamp_error := fbElevation.bError;
			
		8:	// Azimuth Control
			lamp_left := fbAzimuth.inDigitalInputs.0;
			lamp_right := fbAzimuth.inDigitalInputs.1;
			fbAzimuth.MoveNeg := direction_left AND fbAzimuth.inDigitalInputs.0;
			fbAzimuth.MovePos := direction_right AND fbAzimuth.inDigitalInputs.1;
			fbAzimuth.bReset := reset_switch;
			IF key_switch THEN
				AzimuthEnable(
					SET := start_switch, 
					Q := fbAzimuth.bEnable);
				lamp_error := fbAzimuth.Error;
			END_IF
			
		9: 	// Dome control
			
		10:	// FilterWheel control
			
		11: lamp_up := fbElevation.fTorque > 0.0;
			lamp_down := fbElevation.fTorque < 0.0;
			
		12:	// manual Telescope Control
			IF key_switch THEN
				lamp_up := fbTelescope.bPower;
				lamp_down := fbTelescope.bPower;
				lamp_left := fbTelescope.bPower;
				lamp_right := fbTelescope.bPower;
		
				fbTelescope.bGoHome := direction_down;
				fbTelescope.bPark := direction_up;
				fbTelescope.bGoto := direction_right;
				TrackingEnable(SET := start_switch, 
								RESET := reset_switch, 
								Q := fbTelescope.bTrack);
				fbTelescope.bReset := reset_switch;
				fbTelescope.bStop := direction_left;	
				lamp_error := fbTelescope.bError;
			END_IF
			
		13: // Telescope Control
			TelescopeControlEnable(
				SET := start_switch, 
				Q := fbTelescope.bPower);
			fbTelescope.bReset := reset_switch;
			IF key_switch THEN
				lamp_up := fbElevation.inDigitalInputs.0;
				lamp_down := fbElevation.inDigitalInputs.1;
				lamp_left := fbAzimuth.inDigitalInputs.0;
				lamp_right := fbAzimuth.inDigitalInputs.1;
				fbElevation.MovePos := direction_up AND fbElevation.inDigitalInputs.0;
				fbElevation.MoveNeg := direction_down AND fbElevation.inDigitalInputs.1;
				fbAzimuth.MoveNeg := direction_left AND fbAzimuth.inDigitalInputs.0;
				fbAzimuth.MovePos := direction_right AND fbAzimuth.inDigitalInputs.1;
				fbTelescope.fRightAscension := fbTelescope.fRightAscensionCalc;
				fbTelescope.fDeclination := fbTelescope.fDeclinationCalc;
			ELSE
				lamp_up := fbElevation.bEnable;
				lamp_down := fbElevation.bEnable;
				lamp_left := fbAzimuth.bEnable;
				lamp_right := fbAzimuth.bEnable;
				// one 10 arcsec step per press (was: per cycle while held, about 1000 arcsec/s) (#12)
				IF up_trigger.Q THEN
					fbTelescope.fElevationOffset := fbTelescope.fElevationOffset + 10.0/3600.0;
				ELSIF down_trigger.Q THEN
					fbTelescope.fElevationOffset := fbTelescope.fElevationOffset - 10.0/3600.0;
				END_IF;
				IF left_trigger.Q THEN
					fbTelescope.fAzimuthOffset := fbTelescope.fAzimuthOffset - 10.0/3600.0;
				ELSIF right_trigger.Q THEN
					fbTelescope.fAzimuthOffset := fbTelescope.fAzimuthOffset + 10.0/3600.0;
				END_IF;
			END_IF
			// restart TwinCAT: manual mode only, reset held 3 s, suction pump stopped (#12). The inputs are gated, not the
			// calls: the timer and TC_Restart must see their input drop when the key goes off
			ResetDelay(IN := key_switch AND reset_switch, PT := T#3S);
			TwinCATRestart(NETID := '', RESTART := key_switch AND ResetDelay.Q AND NOT fbHydraulics.SuctionRunning, TMOUT := T#60S);
		
		14: horn := key_switch;
			lamp_up := key_switch;
			lamp_down := key_switch;
			lamp_left := key_switch;
			lamp_right := key_switch;
		
		15:	// Hydraulics control
			lamp_up := fbHydraulics.OilPressureOK AND NOT fbBrake.BrakeOpen;
			lamp_down := fbHydraulics.OilPressureOK AND fbBrake.BrakeOpen;
			lamp_left := fbHydraulics.PumpRunning;
			lamp_right := fbHydraulics.SuctionRunning;
			IF key_switch THEN
				IF fbStartTrigger.Q THEN
					fbHydraulics.Enable := NOT fbHydraulics.Enable;
				END_IF
				IF reset_trigger.Q THEN
					fbHydraulics.Reset();
				END_IF
				
				IF direction_up THEN
					fbBrake.OpenBrake();
				END_IF
				IF direction_down THEN
					fbBrake.CloseBrake();
				END_IF
				fbHydraulics.ManualStartSuction := direction_right;
				fbHydraulics.ManualStopPump := direction_left;
				lamp_error := fbHydraulics.Error;
			END_IF
	END_CASE
END_IF

// process outputs of this scan
stOut.bLampUp := lamp_up;
stOut.bLampDown := lamp_down;
stOut.bLampRight := lamp_right;
stOut.bLampLeft := lamp_left;
stOut.bLampError := lamp_error;]]></ST>
    </Implementation>
    <Method Name="_ReferencesValid" Id="{5b0e4c1d-8f3a-4e27-9d61-2c7a90b4e816}">
      <Declaration><![CDATA[// TRUE if every reference the given selector position uses is set (#16).
METHOD PRIVATE _ReferencesValid : BOOL
VAR_INPUT
	nSelection	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nSelection OF
	1, 2, 3:	_ReferencesValid := __ISVALIDREF(fbCovers);
	5:			_ReferencesValid := __ISVALIDREF(fbFocus);
	6:			_ReferencesValid := __ISVALIDREF(fbDerotator);
	7, 11:		_ReferencesValid := __ISVALIDREF(fbElevation);
	8:			_ReferencesValid := __ISVALIDREF(fbAzimuth);
	12:			_ReferencesValid := __ISVALIDREF(fbTelescope);
	13:			_ReferencesValid := __ISVALIDREF(fbTelescope) AND __ISVALIDREF(fbElevation)
									AND __ISVALIDREF(fbAzimuth) AND __ISVALIDREF(fbHydraulics);
	15:			_ReferencesValid := __ISVALIDREF(fbHydraulics) AND __ISVALIDREF(fbBrake);
ELSE
	_ReferencesValid := TRUE;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Property Name="State" Id="{bd9e36e6-fa01-480c-8082-1ea180f879ce}">
      <Declaration><![CDATA[// Disconnected (selector at 0), ReferencesMissing (the selected block is not connected), Automatic or Manual (key switch).
PROPERTY State : E_PendantState]]></Declaration>
      <Get Name="Get" Id="{9eaaafa5-403f-4205-a616-daaa40c3d8b7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[State := ePendantState;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Init" Id="{377c4b19-44fb-4929-801b-86205f66218e}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	comm			: I_Comm;   
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.fbComm 	:= comm;]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_PendantControl">
      <LineId Id="2929" Count="204" />
      <LineId Id="235" Count="0" />
    </LineIds>
    <LineIds Name="FB_PendantControl.FB_Init">
      <LineId Id="7" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>